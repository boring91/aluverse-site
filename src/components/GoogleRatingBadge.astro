---
type Props = {
    rating: number;
    totalReviews: number;
};

const { rating, totalReviews } = Astro.props;
const GOOGLE_GOLD = "#FBBC05";
---

<a
    href="#reviews"
    class="group fixed bottom-4 right-4 md:bottom-6 md:right-6 z-40 flex items-center gap-3 bg-white border border-divider px-3.5 py-2.5 md:px-4 md:py-3 shadow-[0_10px_30px_rgba(20,20,20,0.12)] hover:shadow-[0_16px_38px_rgba(20,20,20,0.18)] hover:-translate-y-0.5 transition-all duration-300"
    aria-label={`Google rating ${rating.toFixed(1)} out of 5 from ${totalReviews} reviews. Tap to view reviews.`}
>
    <svg
        viewBox="0 0 24 24"
        class="size-7 md:size-8 shrink-0"
        aria-hidden="true"
    >
        <path
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            fill="#4285F4"></path>
        <path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            fill="#34A853"></path>
        <path
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            fill="#FBBC05"></path>
        <path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            fill="#EA4335"></path>
    </svg>
    <div class="flex flex-col leading-none">
        <div class="flex items-center gap-1.5">
            <span
                class="font-bold text-[15px] md:text-base text-text-primary"
                >{rating.toFixed(1)}</span
            >
            <div
                class="flex items-center gap-0.5"
                aria-hidden="true"
            >
                {
                    Array.from({ length: 5 }).map(() => (
                        <svg
                            viewBox="0 0 24 24"
                            class="size-3"
                            style={`fill: ${GOOGLE_GOLD}`}
                        >
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                    ))
                }
            </div>
        </div>
        <span
            class="mt-1.5 text-[10px] font-semibold tracking-[0.22em] uppercase text-text-muted group-hover:text-text-primary transition-colors"
        >
            {totalReviews} Google Reviews
        </span>
    </div>
</a>
