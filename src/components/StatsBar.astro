---
import { stats } from '../data/site';
---

<section class="bg-dark border-y border-white/10">
	<div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4">
		{stats.map((stat, i) => (
			<div class:list={['px-6 py-10 text-center', i < stats.length - 1 && 'md:border-r md:border-white/10']}>
				<div class="font-display text-3xl md:text-4xl text-anodise mb-1" data-target={stat.target}>0</div>
				<div class="text-xs font-medium text-white/50 tracking-wider uppercase">{stat.label}</div>
			</div>
		))}
	</div>
</section>
