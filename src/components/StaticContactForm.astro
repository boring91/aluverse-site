---
import { contactUsServices } from "../data/site";

type Props = {
    variant: "contact" | "quote";
};

const { variant } = Astro.props;
const isQuote = variant === "quote";

const inputClass =
    "w-full py-3.5 px-4 border border-form-border bg-form-input-bg font-body text-[0.88rem] text-text-primary outline-none transition-[border-color] duration-300 focus:border-accent";
const labelClass =
    "block text-[0.72rem] font-semibold tracking-[0.08em] uppercase text-text-muted mb-2";
const selectClass = inputClass;
---

<div
    class="bg-form-bg border border-form-border border-t-2 border-t-anodise p-10 reveal reveal-delay-1"
>
    <h3 class="font-display text-[1.4rem] font-normal mb-8">
        {isQuote ? "Quote Request Form" : "Send Us a Message"}
    </h3>

    {
        isQuote ? (
            <form data-static-form>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="mb-5">
                        <label for="fullname" class={labelClass}>
                            Full Name
                        </label>
                        <input
                            type="text"
                            id="fullname"
                            name="fullname"
                            placeholder="Your full name"
                            required
                            class={inputClass}
                        />
                    </div>
                    <div class="mb-5">
                        <label for="phone" class={labelClass}>
                            Phone
                        </label>
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder="Your phone number"
                            required
                            class={inputClass}
                        />
                    </div>
                </div>

                <div class="mb-5">
                    <label for="email" class={labelClass}>
                        Email
                    </label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Your email address"
                        required
                        class={inputClass}
                    />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="mb-5">
                        <label for="property-type" class={labelClass}>
                            Property Type
                        </label>
                        <select
                            id="property-type"
                            name="property_type"
                            class={selectClass}
                        >
                            <option value="" selected disabled>
                                Select property type
                            </option>
                            <option value="residential">Residential</option>
                            <option value="commercial">Commercial</option>
                            <option value="strata">Strata</option>
                        </select>
                    </div>
                    <div class="mb-5">
                        <label for="contact-method" class={labelClass}>
                            Preferred Contact Method
                        </label>
                        <select
                            id="contact-method"
                            name="contact_method"
                            class={selectClass}
                        >
                            <option value="" selected disabled>
                                Select preference
                            </option>
                            <option value="phone">Phone</option>
                            <option value="email">Email</option>
                            <option value="either">Either</option>
                        </select>
                    </div>
                </div>

                <div class="mb-5">
                    <label for="product-interest" class={labelClass}>
                        Product Interest
                    </label>
                    <select
                        id="product-interest"
                        name="product_interest"
                        class={selectClass}
                    >
                        <option value="" selected disabled>
                            What are you interested in?
                        </option>
                        <option value="windows">Windows</option>
                        <option value="doors">Doors</option>
                        <option value="both">Both Windows & Doors</option>
                        <option value="security-screens">
                            Security Screens
                        </option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="mb-5">
                        <label for="quantity" class={labelClass}>
                            Number of Windows/Doors
                        </label>
                        <input
                            type="number"
                            id="quantity"
                            name="quantity"
                            placeholder="e.g. 5"
                            min="1"
                            class={inputClass}
                        />
                    </div>
                    <div class="mb-5">
                        <label for="timeframe" class={labelClass}>
                            Preferred Timeframe
                        </label>
                        <select
                            id="timeframe"
                            name="timeframe"
                            class={selectClass}
                        >
                            <option value="" selected disabled>
                                Select timeframe
                            </option>
                            <option value="asap">ASAP</option>
                            <option value="1-3-months">1-3 Months</option>
                            <option value="3-6-months">3-6 Months</option>
                            <option value="exploring">Just Exploring</option>
                        </select>
                    </div>
                </div>

                <div class="mb-5">
                    <label for="description" class={labelClass}>
                        Project Description
                    </label>
                    <textarea
                        id="description"
                        name="description"
                        placeholder="Please describe your project in as much detail as possible..."
                        class={`${inputClass} h-[150px] resize-y`}
                    />
                </div>

                <div class="mb-5">
                    <label for="referral" class={labelClass}>
                        How Did You Hear About Us?
                    </label>
                    <select id="referral" name="referral" class={selectClass}>
                        <option value="" selected disabled>
                            Select an option
                        </option>
                        <option value="google">Google</option>
                        <option value="social-media">Social Media</option>
                        <option value="hipages">hipages</option>
                        <option value="referral">Referral</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <button
                    type="submit"
                    class="w-full py-4 text-[0.8rem] font-bold tracking-[0.08em] uppercase bg-accent text-white transition-all duration-300 mt-2 cursor-pointer border-none hover:bg-accent-hover"
                >
                    Submit Quote Request
                </button>
                <p class="text-[0.78rem] leading-normal text-text-muted mt-3.5">
                    Static preview only. This form is not connected to a
                    submission endpoint yet.
                </p>
            </form>
        ) : (
            <form data-static-form>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="mb-5">
                        <label for="name" class={labelClass}>
                            Full Name
                        </label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Your full name"
                            required
                            class={inputClass}
                        />
                    </div>
                    <div class="mb-5">
                        <label for="contact-phone" class={labelClass}>
                            Phone
                        </label>
                        <input
                            type="tel"
                            id="contact-phone"
                            name="phone"
                            placeholder="Your phone number"
                            class={inputClass}
                        />
                    </div>
                </div>

                <div class="mb-5">
                    <label for="contact-email" class={labelClass}>
                        Email
                    </label>
                    <input
                        type="email"
                        id="contact-email"
                        name="email"
                        placeholder="Your email address"
                        required
                        class={inputClass}
                    />
                </div>

                <div class="mb-5">
                    <label for="service" class={labelClass}>
                        Service Required
                    </label>
                    <select id="service" name="service" class={selectClass}>
                        <option value="" selected disabled>
                            Select a service
                        </option>
                        {contactUsServices.map(x => {
                            return <option value={x.id}>{x.label}</option>;
                        })}
                    </select>
                </div>

                <div class="mb-5">
                    <label for="message" class={labelClass}>
                        Message
                    </label>
                    <textarea
                        id="message"
                        name="message"
                        placeholder="Tell us about your project..."
                        class={`${inputClass} h-28 resize-y`}
                    />
                </div>

                <button
                    type="submit"
                    class="w-full py-4 text-[0.8rem] font-bold tracking-[0.08em] uppercase bg-accent text-white transition-all duration-300 mt-2 cursor-pointer border-none hover:bg-accent-hover"
                >
                    Send Message
                </button>
                <p class="text-[0.78rem] leading-normal text-text-muted mt-3.5">
                    Static preview only. This form is not connected to a
                    submission endpoint yet.
                </p>
            </form>
        )
    }
</div>
