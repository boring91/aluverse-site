---
import { contactUsServices } from '../data/site';

type Props = {
	variant: 'contact' | 'quote';
};

const { variant } = Astro.props;
const isQuote = variant === 'quote';
---

<div class="bg-white border border-divider border-t-2 border-t-anodise p-8 md:p-10">
	<h3 class="font-display text-xl mb-8">{isQuote ? 'Quote Request Form' : 'Send Us a Message'}</h3>

	{isQuote ? (
		<form data-static-form>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
				<div>
					<label for="fullname" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Full Name</label>
					<input type="text" id="fullname" name="fullname" placeholder="Your full name" required class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors" />
				</div>
				<div>
					<label for="phone" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Phone</label>
					<input type="tel" id="phone" name="phone" placeholder="Your phone number" required class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors" />
				</div>
			</div>

			<div class="mt-5">
				<label for="email" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Email</label>
				<input type="email" id="email" name="email" placeholder="Your email address" required class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors" />
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-5">
				<div>
					<label for="property-type" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Property Type</label>
					<select id="property-type" name="property_type" class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors">
						<option value="" selected disabled>Select property type</option>
						<option value="residential">Residential</option>
						<option value="commercial">Commercial</option>
						<option value="strata">Strata</option>
					</select>
				</div>
				<div>
					<label for="contact-method" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Preferred Contact Method</label>
					<select id="contact-method" name="contact_method" class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors">
						<option value="" selected disabled>Select preference</option>
						<option value="phone">Phone</option>
						<option value="email">Email</option>
						<option value="either">Either</option>
					</select>
				</div>
			</div>

			<div class="mt-5">
				<label for="product-interest" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Product Interest</label>
				<select id="product-interest" name="product_interest" class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors">
					<option value="" selected disabled>What are you interested in?</option>
					<option value="windows">Windows</option>
					<option value="doors">Doors</option>
					<option value="both">Both Windows & Doors</option>
					<option value="security-screens">Security Screens</option>
					<option value="other">Other</option>
				</select>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-5">
				<div>
					<label for="quantity" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Number of Windows/Doors</label>
					<input type="number" id="quantity" name="quantity" placeholder="e.g. 5" min="1" class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors" />
				</div>
				<div>
					<label for="timeframe" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Preferred Timeframe</label>
					<select id="timeframe" name="timeframe" class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors">
						<option value="" selected disabled>Select timeframe</option>
						<option value="asap">ASAP</option>
						<option value="1-3-months">1-3 Months</option>
						<option value="3-6-months">3-6 Months</option>
						<option value="exploring">Just Exploring</option>
					</select>
				</div>
			</div>

			<div class="mt-5">
				<label for="description" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Project Description</label>
				<textarea id="description" name="description" placeholder="Please describe your project..." class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors h-36 resize-y" />
			</div>

			<div class="mt-5">
				<label for="referral" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">How Did You Hear About Us?</label>
				<select id="referral" name="referral" class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors">
					<option value="" selected disabled>Select an option</option>
					<option value="google">Google</option>
					<option value="social-media">Social Media</option>
					<option value="hipages">hipages</option>
					<option value="referral">Referral</option>
					<option value="other">Other</option>
				</select>
			</div>

			<button type="submit" class="w-full py-4 text-xs font-bold tracking-wider uppercase bg-accent text-white mt-6 hover:bg-accent-hover transition-colors">Submit Quote Request</button>
			<p class="text-xs text-text-muted mt-3">Static preview only. This form is not connected to a submission endpoint yet.</p>
		</form>
	) : (
		<form data-static-form>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
				<div>
					<label for="name" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Full Name</label>
					<input type="text" id="name" name="name" placeholder="Your full name" required class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors" />
				</div>
				<div>
					<label for="contact-phone" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Phone</label>
					<input type="tel" id="contact-phone" name="phone" placeholder="Your phone number" class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors" />
				</div>
			</div>

			<div class="mt-5">
				<label for="contact-email" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Email</label>
				<input type="email" id="contact-email" name="email" placeholder="Your email address" required class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors" />
			</div>

			<div class="mt-5">
				<label for="service" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Service Required</label>
				<select id="service" name="service" class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors">
					<option value="" selected disabled>Select a service</option>
					{contactUsServices.map(x => (
						<option value={x.id}>{x.label}</option>
					))}
				</select>
			</div>

			<div class="mt-5">
				<label for="message" class="block text-xs font-semibold tracking-wider uppercase text-text-muted mb-2">Message</label>
				<textarea id="message" name="message" placeholder="Tell us about your project..." class="w-full py-3 px-4 border border-divider bg-alt text-sm outline-none focus:border-accent transition-colors h-28 resize-y" />
			</div>

			<button type="submit" class="w-full py-4 text-xs font-bold tracking-wider uppercase bg-accent text-white mt-6 hover:bg-accent-hover transition-colors">Send Message</button>
			<p class="text-xs text-text-muted mt-3">Static preview only. This form is not connected to a submission endpoint yet.</p>
		</form>
	)}
</div>
