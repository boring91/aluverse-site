---
import { company } from '../data/site';
---

<div>
	<h3 class="font-display text-2xl mb-6">Contact Information</h3>

	<div class="flex gap-4 py-5 border-y border-divider">
		<div class="size-11 border border-divider flex items-center justify-center shrink-0">
			<svg class="size-5 stroke-accent stroke-[1.5] fill-none" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z" /></svg>
		</div>
		<div>
			<h4 class="text-sm font-semibold mb-0.5">Phone</h4>
			<a href={company.phoneHref} class="text-sm text-text-secondary hover:text-accent">{company.phoneDisplay}</a>
		</div>
	</div>

	<div class="flex gap-4 py-5 border-b border-divider">
		<div class="size-11 border border-divider flex items-center justify-center shrink-0">
			<svg class="size-5 stroke-accent stroke-[1.5] fill-none" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
		</div>
		<div>
			<h4 class="text-sm font-semibold mb-0.5">Email</h4>
			<a href={company.emailHref} class="text-sm text-text-secondary hover:text-accent">{company.emailDisplay}</a>
		</div>
	</div>

	<div class="flex gap-4 py-5 border-b border-divider">
		<div class="size-11 border border-divider flex items-center justify-center shrink-0">
			<svg class="size-5 stroke-accent stroke-[1.5] fill-none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
		</div>
		<div>
			<h4 class="text-sm font-semibold mb-0.5">Business Hours</h4>
			<p class="text-sm text-text-secondary">{company.hours}</p>
		</div>
	</div>

	<div class="flex gap-4 py-5 border-b border-divider">
		<div class="size-11 border border-divider flex items-center justify-center shrink-0">
			<svg class="size-5 stroke-accent stroke-[1.5] fill-none" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
		</div>
		<div>
			<h4 class="text-sm font-semibold mb-0.5">Service Area</h4>
			<p class="text-sm text-text-secondary">{company.serviceArea}</p>
		</div>
	</div>

	<div class="flex gap-3 mt-8">
		<a href={company.socials[0].href} target="_blank" rel="noopener noreferrer" aria-label="hipages" class="size-11 border border-divider flex items-center justify-center hover:border-accent hover:bg-accent-light transition-colors">
			<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
		</a>
		<a href={company.socials[1].href} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="size-11 border border-divider flex items-center justify-center hover:border-accent hover:bg-accent-light transition-colors">
			<svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
		</a>
	</div>
</div>
