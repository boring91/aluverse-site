---
import { company, footerProductSlugs, getProductBySlug, getProductHref } from '../data/site';

const featuredProducts = footerProductSlugs
	.map((slug) => getProductBySlug(slug))
	.filter((product): product is NonNullable<typeof product> => Boolean(product));
const year = new Date().getFullYear();
---

<footer class="footer-section">
	<div class="footer-grid">
		<div class="footer-col">
			<a href="/" class="logo" style="margin-bottom:1rem">
				<div class="logo-mark" style="width:32px;height:32px;font-size:0.75rem">A</div>
				<div style="font-size:1.3rem">Alu<span class="logo-accent">verse</span></div>
			</a>
			<p>{company.tagline}</p>
			<div class="footer-social">
				<a href={company.socials[0].href} target="_blank" rel="noopener noreferrer" aria-label="hipages">
					<svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="1.5">
						<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
						<polyline points="9 22 9 12 15 12 15 22"></polyline>
					</svg>
				</a>
				<a href={company.socials[1].href} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
					<svg viewBox="0 0 24 24" fill="rgba(255,255,255,.5)">
						<path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 1.09.044 1.613.115V7.93h-1.143c-1.679 0-2.33.64-2.33 2.303v1.794h3.32l-.571 3.667h-2.749v8.23c5.375-.726 9.528-5.305 9.528-10.862C22.627 6.498 17.958 1.83 12.313 1.83S2 6.498 2 13.063c0 5.21 3.657 9.56 8.535 10.628h-.434z"></path>
					</svg>
				</a>
			</div>
		</div>

		<div class="footer-col">
			<h4>Quick Links</h4>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/windows">Windows</a></li>
				<li><a href="/doors">Doors</a></li>
				<li><a href="/about">About Us</a></li>
				<li><a href="/contact">Contact</a></li>
				<li><a href="/quote">Request Quote</a></li>
			</ul>
		</div>

		<div class="footer-col">
			<h4>Our Products</h4>
			<ul>
				{
					featuredProducts.map((product) => (
						<li><a href={getProductHref(product.slug)}>{product.title}</a></li>
					))
				}
			</ul>
		</div>

		<div class="footer-col">
			<h4>Contact Info</h4>
			<ul>
				<li><a href={company.phoneHref}>{company.phoneDisplay}</a></li>
				<li><a href={company.emailHref}>{company.emailDisplay}</a></li>
				<li>{company.shortHours}</li>
				<li>7 Days a Week</li>
				<li>{company.serviceArea}</li>
			</ul>
		</div>
	</div>

	<div class="footer-bottom">
		<span>&copy; {year} Aluverse Doors and Windows. All rights reserved.</span>
		<span>Australian Standards Compliant | {company.location}</span>
	</div>
</footer>
