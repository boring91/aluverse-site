---
import { company, footerProductSlugs, getProductBySlug, getProductHref } from '../data/site';

const featuredProducts = footerProductSlugs
	.map(slug => getProductBySlug(slug))
	.filter((p): p is NonNullable<typeof p> => Boolean(p));
const year = new Date().getFullYear();
---

<footer class="bg-dark text-white pt-16 px-6">
	<div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
		<div>
			<a href="/" class="font-display text-xl text-white flex items-center gap-2 mb-4">
				<span class="size-8 flex items-center justify-center bg-accent text-white text-xs font-black">A</span>
				Alu<span class="text-anodise">verse</span>
			</a>
			<p class="text-sm text-white/60 leading-relaxed">{company.tagline}</p>
		</div>
		<div>
			<h4 class="font-display text-lg mb-4">Quick Links</h4>
			<ul class="space-y-2 text-sm text-white/50">
				<li><a href="/" class="hover:text-white transition-colors">Home</a></li>
				<li><a href="/windows" class="hover:text-white transition-colors">Windows</a></li>
				<li><a href="/doors" class="hover:text-white transition-colors">Doors</a></li>
				<li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
				<li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
				<li><a href="/quote" class="hover:text-white transition-colors">Request Quote</a></li>
			</ul>
		</div>
		<div>
			<h4 class="font-display text-lg mb-4">Our Products</h4>
			<ul class="space-y-2 text-sm text-white/50">
				{featuredProducts.map(p => (
					<li><a href={getProductHref(p.slug)} class="hover:text-white transition-colors">{p.title}</a></li>
				))}
			</ul>
		</div>
		<div>
			<h4 class="font-display text-lg mb-4">Contact Info</h4>
			<ul class="space-y-2 text-sm text-white/50">
				<li><a href={company.phoneHref} class="hover:text-white transition-colors">{company.phoneDisplay}</a></li>
				<li><a href={company.emailHref} class="hover:text-white transition-colors">{company.emailDisplay}</a></li>
				<li>{company.shortHours}</li>
				<li>7 Days a Week</li>
				<li>{company.serviceArea}</li>
			</ul>
		</div>
	</div>
	<div class="max-w-7xl mx-auto py-8 mt-12 border-t border-white/10 flex flex-col md:flex-row justify-between items-center text-xs text-white/30 gap-2">
		<span>&copy; {year} Aluverse Doors and Windows. All rights reserved.</span>
		<span>Australian Standards Compliant | {company.location}</span>
	</div>
</footer>
