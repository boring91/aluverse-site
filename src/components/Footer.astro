---
import {
    company,
    facadeProducts,
    footerProductSlugs,
    getProductBySlug,
    getProductHref,
} from "../data/site";
import Logo from "./Logo.astro";

const featuredProducts = footerProductSlugs
    .map(slug => getProductBySlug(slug))
    .filter((p): p is NonNullable<typeof p> => Boolean(p));
const facadeProduct = facadeProducts[0];
const year = new Date().getFullYear();
---

<footer class="bg-dark text-white pt-16 px-6">
    <div
        class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10"
    >
        <div class="flex flex-col gap-2">
            <Logo />
            <p class="text-sm text-white/60 leading-relaxed">
                {company.tagline}
            </p>
        </div>
        <div>
            <p class="font-display text-lg mb-4">Quick Links</p>
            <ul class="space-y-2 text-sm text-white/50">
                <li>
                    <a href="/" class="hover:text-white transition-colors"
                        >Home</a
                    >
                </li>
                <li>
                    <a
                        href="/windows"
                        class="hover:text-white transition-colors">Windows</a
                    >
                </li>
                <li>
                    <a href="/doors" class="hover:text-white transition-colors"
                        >Doors</a
                    >
                </li>
                <li>
                    <a
                        href="/screens"
                        class="hover:text-white transition-colors">Screens</a
                    >
                </li>
                {
                    facadeProduct && (
                        <li>
                            <a
                                href={getProductHref(facadeProduct.slug)}
                                class="hover:text-white transition-colors"
                            >
                                Facades
                            </a>
                        </li>
                    )
                }
                <li>
                    <a href="/about" class="hover:text-white transition-colors"
                        >About Us</a
                    >
                </li>
                <li>
                    <a
                        href="/quote"
                        class="hover:text-white transition-colors"
                        >Request a Quote</a
                    >
                </li>
                <li>
                    <a href={company.phoneHref} class="hover:text-white transition-colors"
                        >Call Now</a
                    >
                </li>
            </ul>
        </div>
        <div>
            <p class="font-display text-lg mb-4">Our Products</p>
            <ul class="space-y-2 text-sm text-white/50">
                {
                    featuredProducts.map(p => (
                        <li>
                            <a
                                href={getProductHref(p.slug)}
                                class="hover:text-white transition-colors"
                            >
                                {p.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
        <div>
            <p class="font-display text-lg mb-4">Contact Info</p>
            <ul class="space-y-2 text-sm text-white/50">
                <li>
                    <a
                        href={company.phoneHref}
                        class="hover:text-white transition-colors"
                        >{company.phoneDisplay}</a
                    >
                </li>
                <li>
                    <a
                        href={company.emailHref}
                        class="hover:text-white transition-colors"
                        >{company.emailDisplay}</a
                    >
                </li>
                <li>{company.shortHours}</li>
                <li>6 Days a Week</li>
                <li>{company.serviceArea}</li>
            </ul>
        </div>
    </div>
    <div
        class="max-w-7xl mx-auto pt-8 mt-12 border-t border-white/10"
    >
        <dl
            class="flex flex-wrap gap-x-6 gap-y-2 text-xs text-white/50"
        >
            {
                company.compliance.map(item => (
                    <div class="flex gap-1.5">
                        <dt class="text-white/40">{item.label}:</dt>
                        <dd class="text-white/70">{item.value}</dd>
                    </div>
                ))
            }
        </dl>
    </div>
    <div
        class="max-w-7xl mx-auto py-8 flex flex-col md:flex-row justify-between items-center text-xs text-white/60 gap-2"
    >
        <span
            >&copy; {year} Aluverse Doors and Windows. All rights reserved.</span
        >
        <span>Australian Standards Compliant | {company.location}</span>
    </div>
</footer>
