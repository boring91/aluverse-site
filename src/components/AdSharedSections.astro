---
import { Image } from "astro:assets";
import { pageImages } from "../assets/images";
import { company } from "../data/site";
import SocialSection from "./SocialSection.astro";
import { GoogleReviewsCarousel } from "./GoogleReviewsCarousel";
import { fetchGoogleReviews } from "../lib/google-reviews";
import {
    GOOGLE_PLACES_API_KEY,
    GOOGLE_PLACE_ID,
} from "astro:env/server";

const reviewsData = await fetchGoogleReviews(
    GOOGLE_PLACES_API_KEY,
    GOOGLE_PLACE_ID,
);

type WhyItem = {
    title: string;
    text: string;
};

type Props = {
    whyTag: string;
    whyTitle: string;
    whyText: string;
    whyItems: WhyItem[];
    aboutTitle: string;
    aboutText: string;
    aboutBullets: string[];
    ctaTag: string;
    ctaTitle: string;
    ctaText: string;
};

const {
    whyTag,
    whyTitle,
    whyText,
    whyItems,
    aboutTitle,
    aboutText,
    aboutBullets,
    ctaTag,
    ctaTitle,
    ctaText,
} = Astro.props;

const featureImageWidths = [480, 768, 960, 1280];
const featureImageQuality = 62;
---

<!-- Why choose us -->
<section class="py-20 bg-dark text-white border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-12">
            <p
                class="text-xs font-semibold tracking-widest uppercase text-anodise mb-3"
            >
                {whyTag}
            </p>
            <h2 class="font-display text-3xl md:text-4xl leading-tight mb-3">
                {whyTitle}
            </h2>
            <p
                class="text-sm text-white/50 max-w-lg leading-relaxed mx-auto"
            >
                {whyText}
            </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                whyItems.map(item => (
                    <div class="p-10 border border-white/10 bg-white/5 hover:bg-white/10 transition-colors">
                        <div class="size-12 border border-anodise/30 flex items-center justify-center mb-6">
                            <svg
                                class="size-6 stroke-anodise stroke-[1.5] fill-none"
                                viewBox="0 0 24 24"
                            >
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                        </div>
                        <h3 class="font-display text-lg mb-3">
                            {item.title}
                        </h3>
                        <p class="text-sm text-white/45 leading-relaxed">
                            {item.text}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<!-- About / Workshop -->
<section class="py-20 bg-alt">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
            <div class="aspect-6/5 overflow-hidden">
                <Image
                    src={pageImages.workshopPhoto}
                    alt="Aluverse aluminium fabrication workshop in Sydney"
                    widths={featureImageWidths}
                    sizes="(min-width: 768px) calc((min(100vw, 80rem) - 7.5rem) / 2), calc(100vw - 3rem)"
                    quality={featureImageQuality}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                />
            </div>
            <div>
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Who We Are
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-4"
                >
                    {aboutTitle}
                </h2>
                <p
                    class="text-sm text-text-secondary max-w-lg leading-relaxed mb-8"
                >
                    {aboutText}
                </p>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    {
                        aboutBullets.map(item => (
                            <li class="flex items-start gap-2.5 text-sm text-text-secondary">
                                <svg
                                    class="size-4 stroke-accent stroke-2 fill-none shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                >
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="py-24 bg-page">
    <div class="max-w-7xl mx-auto px-6">
        <GoogleReviewsCarousel
            client:idle
            data={reviewsData}
        />
    </div>
</section>

<!-- CTA -->
<section class="bg-cta text-white px-6 py-24 text-center">
    <div class="max-w-xl mx-auto">
        <p
            class="text-xs font-semibold tracking-widest uppercase text-anodise mb-4"
        >
            {ctaTag}
        </p>
        <h2 class="font-display text-3xl md:text-4xl leading-tight mb-4">
            {ctaTitle}
        </h2>
        <p class="text-white/60 leading-relaxed mb-10">{ctaText}</p>
        <div class="flex justify-center gap-4 flex-wrap">
            <a
                href={company.phoneHref}
                class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase bg-white text-dark hover:bg-gray-100 transition-colors"
                >Call {company.phoneDisplay}</a
            >
            <a
                href="#quote"
                class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase border border-white/30 hover:border-white/70 hover:bg-white/5 transition-colors"
                >Request a Quote</a
            >
        </div>
    </div>
</section>

<!-- Social -->
<SocialSection />
