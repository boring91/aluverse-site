---
import type { Product } from "../data/site";
import { getProductHref } from "../data/site";

type Props = {
    product: Product;
    variant?: "card" | "carousel-card";
    description?: string;
    revealClass?: string;
};

const {
    product,
    variant = "card",
    description = product.summary,
    revealClass = "",
} = Astro.props;

const isCarousel = variant === "carousel-card";

const wrapperClass = isCarousel
    ? `carousel-card card-zoom min-w-[calc(25%-1.125rem)] max-lg:min-w-[calc(33.333%-1rem)] max-md:min-w-[calc(50%-0.75rem)] max-[480px]:min-w-[calc(100%-0.5rem)] shrink-0 bg-card border border-divider border-t-2 border-t-anodise overflow-hidden transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_16px_48px_rgba(45,44,44,0.08)] hover:border-t-accent ${revealClass}`
    : `card-zoom bg-card border border-divider border-t-2 border-t-anodise overflow-hidden transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_16px_48px_rgba(45,44,44,0.08)] hover:border-t-accent ${revealClass}`;
---

<div class={wrapperClass}>
    <div class="aspect-4/3 overflow-hidden relative bg-placeholder">
        <img
            src={product.cardImage}
            alt={product.imageAlt}
            loading="lazy"
            class="card-zoom-img w-full h-full object-cover transition-transform duration-600 ease-in-out"
        />
    </div>
    <div class="card-body p-6">
        <h3
            class="font-display text-[1.2rem] font-normal mb-2 tracking-[0.01em]"
        >
            {product.title}
        </h3>
        <p class="text-[0.95rem] text-text-secondary leading-relaxed">
            {description}
        </p>
        <a
            href={getProductHref(product.slug)}
            class="card-link inline-flex items-center gap-1.5 mt-3 text-xs font-semibold text-accent tracking-[0.05em] uppercase transition-[gap] duration-300 hover:gap-2.5"
        >
            Learn More
            <svg
                class="w-3.5 h-3.5 stroke-current fill-none stroke-2"
                viewBox="0 0 24 24"
                aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
            >
        </a>
    </div>
</div>
