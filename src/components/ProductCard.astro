---
import { Image } from "astro:assets";
import type { Product } from "../data/site";
import { getProductHref } from "../data/site";

type Props = {
    product: Product;
};

const { product } = Astro.props;
const cardWidths = [320, 480, 640, 768];
const cardQuality = 60;
---

<div
    class="group border border-divider border-t-2 border-t-anodise bg-white overflow-hidden transition-all hover:-translate-y-1 hover:shadow-lg"
>
    <div class="aspect-4/3 overflow-hidden bg-alt">
        <Image
            src={product.cardImage}
            alt={product.imageAlt}
            widths={cardWidths}
            sizes="(min-width: 1024px) calc((100vw - 8rem) / 3), (min-width: 768px) calc((100vw - 6rem) / 2), calc(100vw - 3rem)"
            quality={cardQuality}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
    </div>
    <div class="p-6">
        <h3 class="font-display text-lg text-text-primary mb-2">
            {product.title}
        </h3>
        <p class="text-sm text-text-secondary leading-relaxed">
            {product.summary}
        </p>
        <a
            href={getProductHref(product.slug)}
            class="inline-flex items-center gap-1.5 mt-4 text-xs font-semibold text-accent tracking-wide uppercase hover:gap-3 transition-all"
        >
            View {product.title}
            <svg
                class="size-3.5 stroke-current fill-none stroke-2"
                viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
            >
        </a>
    </div>
</div>
