---
type Props = {
	title: string;
	subtitle?: string;
	image: string;
	imageAlt: string;
	breadcrumbs: { label: string; href?: string }[];
};

const { title, subtitle, image, imageAlt, breadcrumbs } = Astro.props;
---

<section class="min-h-[35vh] md:min-h-[40vh] flex items-end text-white relative pt-16 overflow-hidden">
	<img class="absolute inset-0 w-full h-full object-cover" src={image} alt={imageAlt} loading="eager" />
	<div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/50 to-black/30"></div>
	<div class="max-w-7xl mx-auto px-6 py-12 w-full relative z-10">
		<nav class="flex flex-wrap items-center gap-1.5 text-xs mb-4" aria-label="Breadcrumb">
			{breadcrumbs.map((item, i) => (
				<>
					{i > 0 && <span class="text-white/25">/</span>}
					{item.href
						? <a href={item.href} class="text-white/50 hover:text-white transition-colors">{item.label}</a>
						: <span class="text-anodise font-semibold">{item.label}</span>
					}
				</>
			))}
		</nav>
		<h1 class="font-display text-4xl md:text-5xl leading-tight mb-2">{title}</h1>
		{subtitle && <p class="text-white/60 max-w-lg leading-relaxed">{subtitle}</p>}
	</div>
</section>
