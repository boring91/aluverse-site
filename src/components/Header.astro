---
import { company, doorProducts, getProductHref, windowProducts } from '../data/site';

type Props = {
	activeNav?: 'home' | 'windows' | 'doors' | 'about' | 'contact';
};

const { activeNav } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-header-bg border-b border-header-border backdrop-blur-xl">
	<div class="flex items-center justify-between h-16 max-w-7xl mx-auto px-6">
		<a href="/" class="font-display text-2xl text-white flex items-center gap-2">
			<span class="size-9 flex items-center justify-center bg-accent text-white text-sm font-black">A</span>
			Alu<span class="text-anodise">verse</span>
		</a>

		<nav class="hidden lg:flex gap-8 items-center">
			<a href="/" class:list={['text-xs font-medium tracking-widest uppercase transition-colors', activeNav === 'home' ? 'text-white' : 'text-white/60 hover:text-white']}>Home</a>

			<div class="group relative">
				<a href="/windows" class:list={['text-xs font-medium tracking-widest uppercase transition-colors flex items-center gap-1', activeNav === 'windows' ? 'text-white' : 'text-white/60 hover:text-white']}>
					Windows
					<svg class="size-2.5 stroke-current fill-none stroke-2 transition-transform group-hover:rotate-180" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
				</a>
				<div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all">
					<div class="bg-[rgba(10,10,10,0.97)] backdrop-blur-xl border border-white/10 min-w-52 py-2">
						<a href="/windows" class="block px-5 py-2 text-xs text-white/50 hover:text-white hover:bg-white/5">All Windows</a>
						{windowProducts.map(p => (
							<a href={getProductHref(p.slug)} class="block px-5 py-2 text-xs text-white/50 hover:text-white hover:bg-white/5">{p.title}</a>
						))}
					</div>
				</div>
			</div>

			<div class="group relative">
				<a href="/doors" class:list={['text-xs font-medium tracking-widest uppercase transition-colors flex items-center gap-1', activeNav === 'doors' ? 'text-white' : 'text-white/60 hover:text-white']}>
					Doors
					<svg class="size-2.5 stroke-current fill-none stroke-2 transition-transform group-hover:rotate-180" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
				</a>
				<div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all">
					<div class="bg-[rgba(10,10,10,0.97)] backdrop-blur-xl border border-white/10 min-w-52 py-2">
						<a href="/doors" class="block px-5 py-2 text-xs text-white/50 hover:text-white hover:bg-white/5">All Doors</a>
						{doorProducts.map(p => (
							<a href={getProductHref(p.slug)} class="block px-5 py-2 text-xs text-white/50 hover:text-white hover:bg-white/5">{p.title}</a>
						))}
					</div>
				</div>
			</div>

			<a href="/about" class:list={['text-xs font-medium tracking-widest uppercase transition-colors', activeNav === 'about' ? 'text-white' : 'text-white/60 hover:text-white']}>About</a>
			<a href="/contact" class:list={['text-xs font-medium tracking-widest uppercase transition-colors', activeNav === 'contact' ? 'text-white' : 'text-white/60 hover:text-white']}>Contact</a>
		</nav>

		<div class="flex items-center gap-4">
			<a href={company.phoneHref} class="hidden sm:flex items-center gap-2 text-sm text-white/80">
				<svg class="size-4 stroke-anodise fill-none stroke-2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z" /></svg>
				{company.phoneDisplay}
			</a>
			<a href="/quote" class="px-5 py-2 text-xs font-bold bg-accent text-white tracking-wide uppercase hover:bg-accent-hover transition-colors">Get Free Quote</a>
			<button type="button" class="flex flex-col gap-1 p-1 lg:hidden" id="menuToggle" aria-label="Toggle menu" aria-expanded="false">
				<span class="w-5 h-0.5 bg-white block"></span>
				<span class="w-5 h-0.5 bg-white block"></span>
				<span class="w-5 h-0.5 bg-white block"></span>
			</button>
		</div>
	</div>

	<nav class="hidden lg:hidden bg-header-bg border-t border-header-border px-6 py-4 max-h-[calc(100vh-64px)] overflow-y-auto" id="mobileNav">
		<a href="/" class="block py-3 text-sm text-white/70 border-b border-white/5 uppercase tracking-wide">Home</a>
		<div>
			<button type="button" class="flex justify-between items-center w-full py-3 text-sm text-white/70 border-b border-white/5 uppercase tracking-wide" data-dropdown-toggle aria-expanded="false">
				Windows
				<svg class="size-3 stroke-current fill-none stroke-2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
			</button>
			<div class="hidden pl-4 pb-2">
				<a href="/windows" class="block py-2 text-sm text-white/50 hover:text-white">All Windows</a>
				{windowProducts.map(p => (
					<a href={getProductHref(p.slug)} class="block py-2 text-sm text-white/50 hover:text-white">{p.title}</a>
				))}
			</div>
		</div>
		<div>
			<button type="button" class="flex justify-between items-center w-full py-3 text-sm text-white/70 border-b border-white/5 uppercase tracking-wide" data-dropdown-toggle aria-expanded="false">
				Doors
				<svg class="size-3 stroke-current fill-none stroke-2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
			</button>
			<div class="hidden pl-4 pb-2">
				<a href="/doors" class="block py-2 text-sm text-white/50 hover:text-white">All Doors</a>
				{doorProducts.map(p => (
					<a href={getProductHref(p.slug)} class="block py-2 text-sm text-white/50 hover:text-white">{p.title}</a>
				))}
			</div>
		</div>
		<a href="/about" class="block py-3 text-sm text-white/70 border-b border-white/5 uppercase tracking-wide">About</a>
		<a href="/contact" class="block py-3 text-sm text-white/70 border-b border-white/5 uppercase tracking-wide">Contact</a>
		<a href="/quote" class="block py-3 text-sm text-anodise uppercase tracking-wide font-medium">Get Free Quote</a>
	</nav>
</header>
