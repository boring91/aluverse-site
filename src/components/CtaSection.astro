---
type Props = {
	tag: string;
	title: string;
	text: string;
	primaryHref: string;
	primaryLabel: string;
	secondaryHref: string;
	secondaryLabel: string;
};

const { tag, title, text, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="bg-cta text-white px-6 py-24 text-center">
	<div class="max-w-xl mx-auto">
		<p class="text-xs font-semibold tracking-widest uppercase text-anodise mb-4">{tag}</p>
		<h2 class="font-display text-3xl md:text-4xl leading-tight mb-4">{title}</h2>
		<p class="text-white/60 leading-relaxed mb-10">{text}</p>
		<div class="flex justify-center gap-4 flex-wrap">
			<a href={primaryHref} class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase bg-white text-dark hover:bg-gray-100 transition-colors">{primaryLabel}</a>
			<a href={secondaryHref} class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase border border-white/30 hover:border-white/70 hover:bg-white/5 transition-colors">{secondaryLabel}</a>
		</div>
	</div>
</section>
