---
import { company } from '../data/site';
---

<section class="bg-dark text-white py-14">
	<div class="max-w-5xl mx-auto px-6 text-center">
		<p class="text-xs font-semibold tracking-widest uppercase text-anodise mb-3">Find Us Online</p>
		<h2 class="font-display text-2xl mb-8">Connect With Us</h2>
		<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
			<a href={company.socials[0].href} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 px-6 py-4 bg-white/5 border border-white/10 min-w-60 hover:bg-white/10 transition-colors">
				<div class="size-11 flex items-center justify-center bg-hipages shrink-0">
					<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
				</div>
				<div class="text-left">
					<div class="font-semibold text-sm">{company.socials[0].label}</div>
					<div class="text-xs text-white/50">{company.socials[0].subtitle}</div>
				</div>
			</a>
			<a href={company.socials[1].href} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 px-6 py-4 bg-white/5 border border-white/10 min-w-60 hover:bg-white/10 transition-colors">
				<div class="size-11 flex items-center justify-center bg-facebook shrink-0">
					<svg class="size-5" viewBox="0 0 24 24" fill="white"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 1.09.044 1.613.115V7.93h-1.143c-1.679 0-2.33.64-2.33 2.303v1.794h3.32l-.571 3.667h-2.749v8.23c5.375-.726 9.528-5.305 9.528-10.862C22.627 6.498 17.958 1.83 12.313 1.83S2 6.498 2 13.063c0 5.21 3.657 9.56 8.535 10.628h-.434z" /></svg>
				</div>
				<div class="text-left">
					<div class="font-semibold text-sm">{company.socials[1].label}</div>
					<div class="text-xs text-white/50">{company.socials[1].subtitle}</div>
				</div>
			</a>
		</div>
	</div>
</section>
