---
import { Image } from "astro:assets";
import CtaSection from "../components/CtaSection.astro";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import StatsBar from "../components/StatsBar.astro";
import { pageImages } from "../assets/images";
import { company } from "../data/site";
import { getBreadcrumbSchema } from "../lib/seo";

const featureImageWidths = [480, 768, 960, 1280];
const featureImageQuality = 62;
---

<Layout
    title="About Us - Aluverse | Premium Aluminium Windows & Doors Sydney"
    description="Learn about Aluverse, Sydney's trusted aluminium fabrication specialist with over a decade of experience across residential and commercial projects."
    activeNav="about"
    canonical="/about"
    ogImage={pageImages.aboutPageHero}
    schema={getBreadcrumbSchema(
        [
            { label: "Home", href: "/" },
            { label: "About Us", href: "/about" },
        ],
        "/about"
    )}
>
    <PageHero
        title="About Aluverse"
        subtitle="A decade of precision craftsmanship serving Sydney's residential and commercial markets."
        image={pageImages.aboutPageHero}
        imageAlt="Aluverse aluminium craftsmanship"
        priority={true}
        breadcrumbs={[{ label: "Home", href: "/" }, { label: "About Us" }]}
    />

    <section class="py-20 bg-page">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div class="aspect-6/5 overflow-hidden">
                    <Image
                        src={pageImages.workshopPhoto}
                        alt="Aluminium fabrication workshop"
                        widths={featureImageWidths}
                        sizes="(min-width: 768px) calc((min(100vw, 80rem) - 7.5rem) / 2), calc(100vw - 3rem)"
                        quality={featureImageQuality}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                    />
                </div>
                <div>
                    <p
                        class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                    >
                        Our Story
                    </p>
                    <h2
                        class="font-display text-3xl md:text-4xl leading-tight mb-4"
                    >
                        Built on Quality, Driven by Craft
                    </h2>
                    <p class="text-sm text-text-secondary leading-relaxed mb-4">
                        Founded over a decade ago, Aluverse has grown from a
                        small workshop into one of Sydney's most trusted
                        aluminium supplier and installation specialists. Our journey has been
                        defined by an unwavering commitment to precision,
                        quality materials, and honest service.
                    </p>
                    <p class="text-sm text-text-secondary leading-relaxed mb-8">
                        Every project we undertake, from a single window
                        replacement to a complete commercial fit-out, receives
                        the same meticulous attention to detail. We believe that
                        premium aluminium doors and windows should be accessible
                        to every Sydney homeowner and business.
                    </p>
                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        {
                            [
                                "Full-service: removal, supply, install, finishing",
                                "Residential & commercial expertise",
                                "Single & double glazing options",
                                "Australian Standards compliant",
                                "Custom designs to your specification",
                                "Local Sydney knowledge & expertise",
                            ].map(item => (
                                <li class="flex items-start gap-2.5 text-sm text-text-secondary">
                                    <svg
                                        class="size-4 stroke-accent stroke-2 fill-none shrink-0 mt-0.5"
                                        viewBox="0 0 24 24"
                                    >
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    {item}
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <StatsBar />

    <section class="py-20 bg-alt">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Our Values
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-3"
                >
                    What Sets Us Apart
                </h2>
                <p
                    class="text-sm text-text-secondary max-w-lg leading-relaxed mx-auto"
                >
                    The principles that guide every project we undertake.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <div
                    class="p-8 border border-divider bg-white hover:border-accent hover:-translate-y-1 transition-all"
                >
                    <div
                        class="size-12 border border-anodise flex items-center justify-center mb-5"
                    >
                        <svg
                            class="size-5 stroke-anodise stroke-[1.5] fill-none"
                            viewBox="0 0 24 24"
                        >
                            <circle cx="12" cy="8" r="7"></circle><polyline
                                points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"
                            ></polyline>
                        </svg>
                    </div>
                    <h3 class="font-display text-lg mb-2.5">
                        Quality Without Compromise
                    </h3>
                    <p class="text-sm text-text-secondary leading-relaxed">
                        We use only premium-grade aluminium profiles and
                        hardware from trusted suppliers. No shortcuts, no
                        substitutes.
                    </p>
                </div>
                <div
                    class="p-8 border border-divider bg-white hover:border-accent hover:-translate-y-1 transition-all"
                >
                    <div
                        class="size-12 border border-anodise flex items-center justify-center mb-5"
                    >
                        <svg
                            class="size-5 stroke-anodise stroke-[1.5] fill-none"
                            viewBox="0 0 24 24"
                        >
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"
                            ></path><circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 00-3-3.87"></path><path
                                d="M16 3.13a4 4 0 010 7.75"></path>
                        </svg>
                    </div>
                    <h3 class="font-display text-lg mb-2.5">Customer First</h3>
                    <p class="text-sm text-text-secondary leading-relaxed">
                        Your vision drives our work. We listen, advise honestly,
                        and deliver solutions tailored to your exact
                        requirements and budget.
                    </p>
                </div>
                <div
                    class="p-8 border border-divider bg-white hover:border-accent hover:-translate-y-1 transition-all"
                >
                    <div
                        class="size-12 border border-anodise flex items-center justify-center mb-5"
                    >
                        <svg
                            class="size-5 stroke-anodise stroke-[1.5] fill-none"
                            viewBox="0 0 24 24"
                        >
                            <circle cx="12" cy="12" r="10"></circle><polyline
                                points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <h3 class="font-display text-lg mb-2.5">
                        Reliable & On Time
                    </h3>
                    <p class="text-sm text-text-secondary leading-relaxed">
                        We respect your time and property. Our team arrives when
                        promised, works efficiently, and leaves your space
                        clean.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <CtaSection
        tag="Get Started"
        title="Ready to Transform Your Space?"
        text="Get your free consultation and quote today. Let us craft the perfect aluminium doors and windows for your home or business."
        primaryHref={company.phoneHref}
        primaryLabel={`Call ${company.phoneDisplay}`}
        secondaryHref="/quote"
        secondaryLabel="Request a Quote"
    />
</Layout>
