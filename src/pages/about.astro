---
import CtaSection from '../components/CtaSection.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import StatsBar from '../components/StatsBar.astro';
import { company } from '../data/site';
---

<Layout
	title="About Us - Aluverse | Premium Aluminium Windows & Doors Sydney"
	description="Learn about Aluverse, Sydney's trusted aluminium fabrication specialist with over a decade of experience across residential and commercial projects."
	activeNav="about"
>
	<PageHero
		title="About Aluverse"
		subtitle="A decade of precision craftsmanship serving Sydney's residential and commercial markets."
		image="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1920&q=80"
		imageAlt="Aluverse aluminium craftsmanship"
		breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'About Us' }]}
	/>

	<section class="py-22 relative bg-page">
		<div class="max-w-[1400px] mx-auto px-6 md:px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-16 max-md:gap-8 items-center">
				<div class="about-img-decorator aspect-[6/5] relative overflow-hidden max-md:after:hidden reveal">
					<img
						src="https://images.unsplash.com/photo-1547555706-54bcf05bbad1?w=1200&q=80"
						alt="Aluminium fabrication workshop"
						loading="lazy"
						class="w-full h-full object-cover"
					/>
				</div>
				<div class="reveal reveal-delay-1">
					<div class="mb-12">
						<div class="section-tag inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.15em] uppercase text-accent mb-4">Our Story</div>
						<h2 class="font-display text-[length:clamp(1.8rem,4vw,2.8rem)] font-[400] tracking-[0.01em] leading-tight mb-3 text-text-primary">Built on Quality, Driven by Craft</h2>
					</div>
					<p class="text-[0.95rem] text-text-secondary leading-[1.8] mb-4">
						Founded over a decade ago, Aluverse has grown from a small workshop into one of
						Sydney's most trusted aluminium fabrication specialists. Our journey has been defined
						by an unwavering commitment to precision, quality materials, and honest service.
					</p>
					<p class="text-[0.95rem] text-text-secondary leading-[1.8] mb-8">
						Every project we undertake, from a single window replacement to a complete
						commercial fit-out, receives the same meticulous attention to detail. We believe that
						premium aluminium solutions should be accessible to every Sydney homeowner and
						business.
					</p>
					<ul class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-8">
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Full-service:
							removal, supply, install, finishing
						</li>
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Residential &
							commercial expertise
						</li>
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Single &
							double glazing options
						</li>
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Australian
							Standards compliant
						</li>
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Custom designs
							to your specification
						</li>
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Local Sydney
							knowledge & expertise
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<StatsBar />

	<section class="py-22 relative bg-alt">
		<div class="max-w-[1400px] mx-auto px-6 md:px-8">
			<div class="text-center mb-12">
				<div class="section-tag section-tag-center inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.15em] uppercase text-accent mb-4 justify-center reveal">Our Values</div>
				<h2 class="font-display text-[length:clamp(1.8rem,4vw,2.8rem)] font-[400] tracking-[0.01em] leading-tight mb-3 text-text-primary reveal reveal-delay-1">What Sets Us Apart</h2>
				<p class="text-[0.95rem] text-text-secondary max-w-[550px] leading-relaxed mx-auto reveal reveal-delay-2">
					The principles that guide every project we undertake.
				</p>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				<div class="p-8 border border-divider transition-all duration-400 hover:border-accent hover:-translate-y-1 hover:shadow-[0_16px_48px_rgba(45,44,44,0.08)] reveal">
					<div class="w-12 h-12 border border-anodise flex items-center justify-center mb-5">
						<svg class="w-[22px] h-[22px] stroke-anodise stroke-[1.5] fill-none" viewBox="0 0 24 24">
							<circle cx="12" cy="8" r="7"></circle>
							<polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
						</svg>
					</div>
					<h3 class="font-display text-[1.15rem] font-[400] mb-2.5">Quality Without Compromise</h3>
					<p class="text-[0.85rem] text-text-secondary leading-relaxed">
						We use only premium-grade aluminium profiles and hardware from trusted Australian
						suppliers. No shortcuts, no substitutes.
					</p>
				</div>
				<div class="p-8 border border-divider transition-all duration-400 hover:border-accent hover:-translate-y-1 hover:shadow-[0_16px_48px_rgba(45,44,44,0.08)] reveal reveal-delay-1">
					<div class="w-12 h-12 border border-anodise flex items-center justify-center mb-5">
						<svg class="w-[22px] h-[22px] stroke-anodise stroke-[1.5] fill-none" viewBox="0 0 24 24">
							<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
							<circle cx="9" cy="7" r="4"></circle>
							<path d="M23 21v-2a4 4 0 00-3-3.87"></path>
							<path d="M16 3.13a4 4 0 010 7.75"></path>
						</svg>
					</div>
					<h3 class="font-display text-[1.15rem] font-[400] mb-2.5">Customer First</h3>
					<p class="text-[0.85rem] text-text-secondary leading-relaxed">
						Your vision drives our work. We listen, advise honestly, and deliver solutions
						tailored to your exact requirements and budget.
					</p>
				</div>
				<div class="p-8 border border-divider transition-all duration-400 hover:border-accent hover:-translate-y-1 hover:shadow-[0_16px_48px_rgba(45,44,44,0.08)] reveal reveal-delay-2">
					<div class="w-12 h-12 border border-anodise flex items-center justify-center mb-5">
						<svg class="w-[22px] h-[22px] stroke-anodise stroke-[1.5] fill-none" viewBox="0 0 24 24">
							<circle cx="12" cy="12" r="10"></circle>
							<polyline points="12 6 12 12 16 14"></polyline>
						</svg>
					</div>
					<h3 class="font-display text-[1.15rem] font-[400] mb-2.5">Reliable & On Time</h3>
					<p class="text-[0.85rem] text-text-secondary leading-relaxed">
						We respect your time and property. Our team arrives when promised, works
						efficiently, and leaves your space clean.
					</p>
				</div>
			</div>
		</div>
	</section>

	<CtaSection
		tag="Get Started"
		title="Ready to Transform Your Space?"
		text="Get your free consultation and quote today. Let us craft the perfect aluminium solution for your home or business."
		primaryHref={company.phoneHref}
		primaryLabel={`Call ${company.phoneDisplay}`}
		secondaryHref="/quote"
		secondaryLabel="Request a Quote"
	/>
</Layout>
