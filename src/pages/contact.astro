---
import ContactInfo from "../components/ContactInfo.astro";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SocialSection from "../components/SocialSection.astro";
import { pageImages } from "../assets/images";
import { ContactForm } from "../components/ContactForm";
import { getBreadcrumbSchema, getFaqSchema } from "../lib/seo";

const contactFaqs = [
    {
        question: "What information should I include in my contact enquiry?",
        answer:
            "The most useful details are the type of windows or doors you need, whether it is a replacement or a new opening, the suburb, approximate opening sizes, and any goals around noise reduction, ventilation, or style. For larger projects, the number of openings and the project timeline are also helpful.",
    },
    {
        question: "Does Aluverse work across Sydney and surrounding areas?",
        answer:
            "Yes. Aluverse services Sydney and surrounding areas for aluminium window and door supply, installation, and related project enquiries, from single-home renovations to large multi-unit developments.",
    },
    {
        question: "Can I contact Aluverse about repairs as well as new installations?",
        answer:
            "Yes. The team handles both new projects and repair-focused enquiries, so the contact page is suitable whether you need a replacement, an upgrade, or maintenance support.",
    },
    {
        question: "What is the best way to reach Aluverse for an urgent enquiry?",
        answer:
            "Calling directly on 0403 422 401 is the fastest way to reach the team. Phone lines are open seven days a week from 6:00 AM to 9:00 PM.",
    },
    {
        question: "Can I arrange a site visit before committing to a project?",
        answer:
            "Yes. Aluverse offers free on-site consultations across Sydney. A site visit allows the team to take accurate measurements, discuss product options in person, and provide a more precise quote for the project.",
    },
    {
        question: "Does Aluverse work with builders and architects on large projects?",
        answer:
            "Yes. Aluverse regularly collaborates with builders, architects, and project managers on large residential developments and commercial fitouts, providing custom fabrication, bulk supply, and coordinated installation scheduling.",
    },
] as const;
const contactSchema = [
    getBreadcrumbSchema(
        [
            { label: "Home", href: "/" },
            { label: "Contact", href: "/contact" },
        ],
        "/contact"
    ),
    getFaqSchema([...contactFaqs]),
];
---

<Layout
    title="Contact Us - Aluverse | Aluminium Windows & Doors Sydney"
    description="Contact Aluverse for a free consultation and quote on premium aluminium windows and doors in Sydney. Call 0403 422 401 or send us a message."
    activeNav="contact"
    canonical="/contact"
    ogImage={pageImages.contactPageHero}
    schema={contactSchema}
>
    <PageHero
        title="Get In Touch"
        subtitle="We'd love to discuss your project. Reach out for a free consultation and quote."
        image={pageImages.contactPageHero}
        imageAlt="Contact Aluverse Sydney"
        priority={true}
        breadcrumbs={[{ label: "Home", href: "/" }, { label: "Contact" }]}
    />

    <section class="py-20 bg-page">
        <div class="max-w-7xl mx-auto px-6">
            <div
                class="grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-16 max-md:gap-8"
            >
                <ContactInfo />
                <ContactForm client:load />
            </div>
        </div>
    </section>

    <section class="py-20 bg-white border-y border-divider">
        <div class="max-w-5xl mx-auto px-6">
            <div class="max-w-3xl mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Contact FAQs
                </p>
                <h2 class="font-display text-3xl md:text-4xl leading-tight mb-4">
                    Before You Send Your Enquiry
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                    This page is often used by people who are close to
                    requesting a quote. These answers make it clearer what to
                    send and what kind of projects we can help with.
                </p>
            </div>
            <div class="grid gap-6">
                {
                    contactFaqs.map(faq => (
                        <article class="p-8 border border-divider bg-page">
                            <h3 class="font-display text-xl mb-3">
                                {faq.question}
                            </h3>
                            <p class="text-sm text-text-secondary leading-relaxed">
                                {faq.answer}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <SocialSection />
</Layout>
