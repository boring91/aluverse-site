---
import ContactInfo from '../components/ContactInfo.astro';
import CtaSection from '../components/CtaSection.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import StaticContactForm from '../components/StaticContactForm.astro';
import { company } from '../data/site';
---

<Layout
	title="Request a Free Quote - Aluverse | Aluminium Windows & Doors Sydney"
	description="Request a free, no-obligation quote for premium aluminium windows and doors in Sydney. Tell us about your project and we'll respond within 24 hours."
>
	<PageHero
		title="Request a Free Quote"
		subtitle="Tell us about your project and we'll provide a detailed, no-obligation quote within 24 hours."
		image="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1920&q=80"
		imageAlt="Request a free quote from Aluverse"
		breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Request a Quote' }]}
	/>

	<section class="py-22 relative bg-alt">
		<div class="max-w-[1400px] mx-auto px-6 md:px-8">
			<div class="text-center mb-12">
				<div class="section-tag section-tag-center inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.15em] uppercase text-accent mb-4 justify-center reveal">How It Works</div>
				<h2 class="font-display text-[length:clamp(1.8rem,4vw,2.8rem)] font-[400] tracking-[0.01em] leading-tight mb-3 text-text-primary reveal reveal-delay-1">Our Simple Process</h2>
				<p class="text-[0.95rem] text-text-secondary max-w-[550px] leading-relaxed mx-auto reveal reveal-delay-2">
					From enquiry to installation, we make it easy.
				</p>
			</div>
			<div class="process-steps grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 reveal">
				<div class="process-step process-step-connector text-center relative px-4 py-8 lg:last:after:hidden max-lg:after:hidden">
					<h3 class="font-display text-[1.1rem] font-[400] mb-2">Submit Your Enquiry</h3>
					<p class="text-[0.85rem] text-text-secondary leading-relaxed">Fill out the form below with your project details, or give us a call.</p>
				</div>
				<div class="process-step process-step-connector text-center relative px-4 py-8 lg:last:after:hidden max-lg:after:hidden">
					<h3 class="font-display text-[1.1rem] font-[400] mb-2">Free Consultation</h3>
					<p class="text-[0.85rem] text-text-secondary leading-relaxed">We'll arrange a convenient time to visit your site and discuss your requirements.</p>
				</div>
				<div class="process-step process-step-connector text-center relative px-4 py-8 lg:last:after:hidden max-lg:after:hidden">
					<h3 class="font-display text-[1.1rem] font-[400] mb-2">Detailed Quote</h3>
					<p class="text-[0.85rem] text-text-secondary leading-relaxed">Receive a comprehensive, itemised quote with no hidden costs or surprises.</p>
				</div>
				<div class="process-step text-center relative px-4 py-8">
					<h3 class="font-display text-[1.1rem] font-[400] mb-2">Professional Installation</h3>
					<p class="text-[0.85rem] text-text-secondary leading-relaxed">Our experienced team completes your project to the highest standards.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="py-22 relative bg-page">
		<div class="max-w-[1400px] mx-auto px-6 md:px-8">
			<div class="text-center mb-12">
				<div class="section-tag section-tag-center inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.15em] uppercase text-accent mb-4 justify-center reveal">Your Project</div>
				<h2 class="font-display text-[length:clamp(1.8rem,4vw,2.8rem)] font-[400] tracking-[0.01em] leading-tight mb-3 text-text-primary reveal reveal-delay-1">Tell Us About Your Project</h2>
				<p class="text-[0.95rem] text-text-secondary max-w-[550px] leading-relaxed mx-auto reveal reveal-delay-2">
					The more detail you provide, the more accurate your quote will be.
				</p>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-16 max-md:gap-8">
				<ContactInfo />
				<StaticContactForm variant="quote" />
			</div>
		</div>
	</section>

	<CtaSection
		tag="Prefer to Talk?"
		title="Call Us Directly"
		text="Our friendly team is available 7 days a week to discuss your project requirements."
		primaryHref={company.phoneHref}
		primaryLabel={`Call ${company.phoneDisplay}`}
		secondaryHref={company.emailHref}
		secondaryLabel="Email Us"
	/>
</Layout>
