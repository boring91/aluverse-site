---
import ContactInfo from "../components/ContactInfo.astro";
import CtaSection from "../components/CtaSection.astro";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { pageImages } from "../assets/images";
import { company } from "../data/site";
import { QuoteForm } from "../components/QuoteForm";
import { getBreadcrumbSchema, getFaqSchema } from "../lib/seo";

const steps = [
    {
        number: "01",
        title: "Submit Your Enquiry",
        text: "Fill out the form below with your project details, or give us a call.",
    },
    {
        number: "02",
        title: "Free Consultation",
        text: "We'll arrange a convenient time to visit your site and discuss your requirements.",
    },
    {
        number: "03",
        title: "Detailed Quote",
        text: "Receive a comprehensive, itemised quote with no hidden costs or surprises.",
    },
    {
        number: "04",
        title: "Professional Installation",
        text: "Our experienced team completes your project to the highest standards.",
    },
];
const quoteFaqs = [
    {
        question:
            "What details help make an aluminium windows and doors quote more accurate?",
        answer:
            "Room or opening type, approximate sizes, your suburb, preferred product style, and whether you want single or double glazing all help make the quote more precise from the start.",
    },
    {
        question:
            "Can I request a quote for replacement windows and doors?",
        answer:
            "Yes. The quote form is suitable for replacement projects, upgrades, and new installations. Mention whether existing frames need removal so the scope is clear.",
    },
    {
        question:
            "How quickly will someone respond to a quote request?",
        answer:
            "The page sets the expectation of a response within 24 hours, and the more complete the project information is, the faster the quote process usually moves.",
    },
] as const;
const quoteSchema = [
    getBreadcrumbSchema(
        [
            { label: "Home", href: "/" },
            { label: "Request a Quote", href: "/quote" },
        ],
        "/quote"
    ),
    getFaqSchema([...quoteFaqs]),
];
---

<Layout
    title="Request a Free Quote - Aluverse | Aluminium Windows & Doors Sydney"
    description="Request a free, no-obligation quote for premium aluminium windows and doors in Sydney. Tell us about your project and we'll respond within 24 hours."
    canonical="/quote"
    ogImage={pageImages.quotePageHero}
    schema={quoteSchema}
>
    <PageHero
        title="Request a Free Quote"
        subtitle="Tell us about your project and we'll provide a detailed, no-obligation quote within 24 hours."
        image={pageImages.quotePageHero}
        imageAlt="Request a free quote from Aluverse"
        priority={true}
        breadcrumbs={[
            { label: "Home", href: "/" },
            { label: "Request a Quote" },
        ]}
    />

    <section class="py-20 bg-alt">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    How It Works
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-3"
                >
                    Our Simple Process
                </h2>
                <p
                    class="text-sm text-text-secondary max-w-lg leading-relaxed mx-auto"
                >
                    From enquiry to installation, we make it easy.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {
                    steps.map(step => (
                        <div class="text-center px-4 py-8">
                            <div class="font-display text-4xl text-anodise mb-4">
                                {step.number}
                            </div>
                            <h3 class="font-display text-lg mb-2">
                                {step.title}
                            </h3>
                            <p class="text-sm text-text-secondary leading-relaxed">
                                {step.text}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-20 bg-page">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Your Project
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-3"
                >
                    Tell Us About Your Project
                </h2>
                <p
                    class="text-sm text-text-secondary max-w-lg leading-relaxed mx-auto"
                >
                    The more detail you provide, the more accurate your quote
                    will be.
                </p>
            </div>
            <div
                class="grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-16 max-md:gap-8"
            >
                <ContactInfo />
                <QuoteForm client:load />
            </div>
        </div>
    </section>

    <section class="py-20 bg-white border-y border-divider">
        <div class="max-w-5xl mx-auto px-6">
            <div class="max-w-3xl mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Quote FAQs
                </p>
                <h2 class="font-display text-3xl md:text-4xl leading-tight mb-4">
                    What Helps Us Quote Your Project Properly
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                    People using this page are usually ready to compare options
                    or costs. These answers clarify what details make the quote
                    process faster and more accurate.
                </p>
            </div>
            <div class="grid gap-6">
                {
                    quoteFaqs.map(faq => (
                        <article class="p-8 border border-divider bg-page">
                            <h3 class="font-display text-xl mb-3">
                                {faq.question}
                            </h3>
                            <p class="text-sm text-text-secondary leading-relaxed">
                                {faq.answer}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <CtaSection
        tag="Prefer to Talk?"
        title="Call Us Directly"
        text="Our friendly team is available 7 days a week to discuss your project requirements."
        primaryHref={company.phoneHref}
        primaryLabel={`Call ${company.phoneDisplay}`}
        secondaryHref={company.emailHref}
        secondaryLabel="Email Us"
    />
</Layout>
