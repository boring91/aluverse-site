---
import { pageImages } from "../assets/images";
import CtaSection from "../components/CtaSection.astro";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ProductCard from "../components/ProductCard.astro";
import { company, getProductHref, windowProducts } from "../data/site";
import {
    getBreadcrumbSchema,
    getFaqSchema,
    getItemListSchema,
} from "../lib/seo";

const windowGuides = [
    {
        title: "Choose by airflow",
        text: "Casement windows suit rooms that need maximum breeze, while sliding windows work well where you want simple day-to-day ventilation without an outward opening sash.",
    },
    {
        title: "Choose by exposure",
        text: "Awning windows are useful when you still want to ventilate during light rain, and double glazing becomes more valuable in exposed rooms or noisy streets.",
    },
    {
        title: "Choose by style and use",
        text: "Double hung windows suit more traditional facades, while bi-fold windows are ideal for kitchen serveries and entertaining spaces that need a wider opening.",
    },
] as const;
const windowFaqs = [
    {
        question: "Which aluminium window is best for ventilation?",
        answer:
            "That depends on the room. Casement windows are excellent for catching breezes and offer a full clear opening, awning windows are practical when you want ventilation during light rain, and sliding windows are a simple choice for everyday use without any outward projection.",
    },
    {
        question: "Can I get custom aluminium windows made to size?",
        answer:
            "Yes. Aluverse fabricates aluminium windows to suit the opening, the selected frame system, and the design requirements of the project rather than relying on one-size-fits-all stock sizes. This applies to individual homes as well as large-scale developments with many openings.",
    },
    {
        question: "Should I choose single glazing or double glazing?",
        answer:
            "Single glazing can still suit some projects, but double glazing is often worth considering when comfort, noise reduction, or energy performance are a priority. For properties near busy roads, flight paths, or in exposed positions, double glazing provides a noticeable improvement.",
    },
    {
        question:
            "What aluminium window types are available for Sydney projects?",
        answer:
            "Aluverse offers sliding, awning, casement, bi-fold, double hung, and double glazed aluminium window systems. Each type can be custom fabricated to suit the opening dimensions, ventilation needs, and architectural style of the project.",
    },
    {
        question:
            "Are aluminium windows a good choice for apartment buildings and large developments?",
        answer:
            "Yes. Aluminium windows are one of the most commonly specified window types for multi-unit residential and commercial projects in Sydney. They offer consistent quality across bulk orders, require minimal ongoing maintenance, and are available in a wide range of configurations and colours.",
    },
    {
        question:
            "What colours and finishes are available for aluminium windows?",
        answer:
            "Aluverse offers the full powder-coat colour range, allowing frames to be matched to virtually any facade. Popular choices include matt black, surfmist, monument, and various anodised-look finishes. Custom colours can be discussed for projects with specific requirements.",
    },
] as const;
const windowSchema = [
    getBreadcrumbSchema(
        [
            { label: "Home", href: "/" },
            { label: "Windows", href: "/windows" },
        ],
        "/windows"
    ),
    getItemListSchema(
        "Aluminium Windows",
        windowProducts.map(product => ({
            name: product.title,
            href: getProductHref(product.slug),
        }))
    ),
    getFaqSchema([...windowFaqs]),
];
---

<Layout
    title="Aluminium Windows Sydney | Custom Fabricated | Aluverse"
    description="Custom aluminium windows for Sydney projects. Sliding, awning, casement, bi-fold, double glazing and double hung systems fabricated to your exact specifications."
    activeNav="windows"
    canonical="/windows"
    ogImage={pageImages.windowsPageHero}
    schema={windowSchema}
>
    <PageHero
        title="Aluminium Windows"
        subtitle="Precision-engineered window systems designed for Australian conditions. Every window is custom-fabricated to your exact specifications."
        image={pageImages.windowsPageHero}
        imageAlt="Premium aluminium windows"
        priority={true}
        breadcrumbs={[{ label: "Home", href: "/" }, { label: "Windows" }]}
    />

    <section class="py-20 bg-page">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Our Range
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-3"
                >
                    Window Systems
                </h2>
                <p
                    class="text-sm text-text-secondary max-w-lg leading-relaxed mx-auto"
                >
                    From classic double hung to modern bi-fold, we offer the
                    complete range of aluminium window solutions.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    windowProducts.map(product => (
                        <ProductCard product={product} />
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-20 bg-dark text-white">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-anodise mb-3"
                >
                    Why Aluminium
                </p>
                <h2 class="font-display text-3xl md:text-4xl leading-tight">
                    The Premium Choice for Sydney Homes
                </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div
                    class="p-10 border border-white/10 bg-white/5 hover:bg-white/10 transition-colors"
                >
                    <div
                        class="size-12 border border-anodise/30 flex items-center justify-center mb-6"
                    >
                        <svg
                            class="size-6 stroke-anodise stroke-[1.5] fill-none"
                            viewBox="0 0 24 24"
                            ><path
                                d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                            ></path></svg
                        >
                    </div>
                    <h3 class="font-display text-lg mb-3">Durability</h3>
                    <p class="text-sm text-white/45 leading-relaxed">
                        Aluminium frames resist corrosion, warping, and
                        cracking. Built to withstand Sydney's coastal climate
                        for decades.
                    </p>
                </div>
                <div
                    class="p-10 border border-white/10 bg-white/5 hover:bg-white/10 transition-colors"
                >
                    <div
                        class="size-12 border border-anodise/30 flex items-center justify-center mb-6"
                    >
                        <svg
                            class="size-6 stroke-anodise stroke-[1.5] fill-none"
                            viewBox="0 0 24 24"
                        >
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line><line
                                x1="12"
                                y1="21"
                                x2="12"
                                y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
                            ></line><line
                                x1="18.36"
                                y1="18.36"
                                x2="19.78"
                                y2="19.78"></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line><line
                                x1="21"
                                y1="12"
                                x2="23"
                                y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
                            ></line><line
                                x1="18.36"
                                y1="5.64"
                                x2="19.78"
                                y2="4.22"></line>
                        </svg>
                    </div>
                    <h3 class="font-display text-lg mb-3">Energy Efficiency</h3>
                    <p class="text-sm text-white/45 leading-relaxed">
                        Combined with quality glazing, aluminium windows provide
                        excellent thermal performance and reduce energy costs.
                    </p>
                </div>
                <div
                    class="p-10 border border-white/10 bg-white/5 hover:bg-white/10 transition-colors"
                >
                    <div
                        class="size-12 border border-anodise/30 flex items-center justify-center mb-6"
                    >
                        <svg
                            class="size-6 stroke-anodise stroke-[1.5] fill-none"
                            viewBox="0 0 24 24"
                        >
                            <polyline points="15 3 21 3 21 9"
                            ></polyline><polyline points="9 21 3 21 3 15"
                            ></polyline>
                            <line x1="21" y1="3" x2="14" y2="10"></line><line
                                x1="3"
                                y1="21"
                                x2="10"
                                y2="14"></line>
                        </svg>
                    </div>
                    <h3 class="font-display text-lg mb-3">Slim Sightlines</h3>
                    <p class="text-sm text-white/45 leading-relaxed">
                        Aluminium's inherent strength allows for slimmer frames,
                        maximising glass area and natural light.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="py-20 bg-white border-t border-divider">
        <div class="max-w-7xl mx-auto px-6">
            <div class="max-w-3xl mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Buying Guide
                </p>
                <h2 class="font-display text-3xl md:text-4xl leading-tight mb-4">
                    How to Choose the Right Aluminium Window
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                    Search intent on this page is usually practical: people are
                    comparing window types, trying to match them to a room, and
                    weighing comfort, ventilation, and glazing options. These
                    quick notes make those comparisons easier.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {
                    windowGuides.map(item => (
                        <article class="p-8 border border-divider bg-page">
                            <h3 class="font-display text-xl mb-3">
                                {item.title}
                            </h3>
                            <p class="text-sm text-text-secondary leading-relaxed">
                                {item.text}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-20 bg-page">
        <div class="max-w-5xl mx-auto px-6">
            <div class="max-w-3xl mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    FAQs
                </p>
                <h2 class="font-display text-3xl md:text-4xl leading-tight mb-4">
                    Questions We Hear About Aluminium Windows
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                    These are the common decision-stage questions people ask
                    before requesting a site visit or quote.
                </p>
            </div>
            <div class="grid gap-6">
                {
                    windowFaqs.map(faq => (
                        <article class="p-8 bg-white border border-divider">
                            <h3 class="font-display text-xl mb-3">
                                {faq.question}
                            </h3>
                            <p class="text-sm text-text-secondary leading-relaxed">
                                {faq.answer}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <CtaSection
        tag="Get Started"
        title="Ready to Transform Your Space?"
        text="Get your free consultation and quote today. Let us craft the perfect doors and windows solution for your home or business."
        primaryHref={company.phoneHref}
        primaryLabel={`Call ${company.phoneDisplay}`}
        secondaryHref="/quote"
        secondaryLabel="Request a Quote"
    />
</Layout>
