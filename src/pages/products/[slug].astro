---
import CtaSection from '../../components/CtaSection.astro';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import { company, getProductBySlug, getProductHref, products } from '../../data/site';

export function getStaticPaths() {
	return products.map((product) => ({
		params: { slug: product.slug },
		props: { product },
	}));
}

const { product } = Astro.props;
const relatedProducts = product.related
	.map((slug: string) => getProductBySlug(slug))
	.filter((item): item is NonNullable<typeof item> => Boolean(item));

const categoryHref = product.category === 'windows' ? '/windows' : '/doors';
const categoryLabel = product.category === 'windows' ? 'Windows' : 'Doors';
const relatedHeading = product.category === 'windows' ? 'Other Window Systems' : 'Other Door Systems';
---

<Layout title={product.metaTitle} description={product.metaDescription} activeNav={product.category}>
	<PageHero
		title={product.title}
		image={product.heroImage}
		imageAlt={product.imageAlt}
		breadcrumbs={[
			{ label: 'Home', href: '/' },
			{ label: categoryLabel, href: categoryHref },
			{ label: product.title },
		]}
	/>

	<section class="py-22 relative bg-page">
		<div class="max-w-[1400px] mx-auto px-6 md:px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-16 max-md:gap-8 items-start">
				<div class="card-zoom aspect-[4/3] overflow-hidden relative border-t-[3px] border-t-anodise reveal">
					<img src={product.heroImage} alt={product.imageAlt} loading="lazy" class="card-zoom-img w-full h-full object-cover transition-transform duration-600" />
				</div>
				<div class="reveal reveal-delay-1">
					<h1 class="font-display text-[length:clamp(1.8rem,4vw,2.6rem)] font-[400] tracking-[0.01em] mb-4 text-text-primary">{product.title}</h1>
					<p class="text-base text-text-secondary leading-[1.85] mb-8">{product.detailDescription}</p>
					<ul class="mb-10">
						{
							product.features.map((feature: string) => (
								<li class="flex items-start gap-3 py-2.5 text-[0.9rem] text-text-secondary border-b border-divider first:border-t first:border-t-divider">
									<svg class="w-[18px] h-[18px] stroke-anodise stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
									{feature}
								</li>
							))
						}
					</ul>
					<div class="flex gap-4 flex-wrap max-[480px]:flex-col">
						<a href="/quote" class="btn-shine relative overflow-hidden inline-flex items-center justify-center gap-2 px-8 py-3.5 font-body text-[0.85rem] font-semibold tracking-[0.04em] uppercase cursor-pointer bg-accent text-text-on-accent transition-all duration-300 hover:brightness-110 hover:-translate-y-0.5 hover:shadow-[0_8px_30px_var(--color-accent-light)] max-[480px]:w-full">
							Get a Quote
							<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2">
								<path d="M5 12h14M12 5l7 7-7 7"></path>
							</svg>
						</a>
						<a href={company.phoneHref} class="btn-shine relative overflow-hidden inline-flex items-center justify-center gap-2 px-8 py-3.5 font-body text-[0.85rem] font-semibold tracking-[0.04em] uppercase cursor-pointer bg-transparent text-accent border border-divider transition-all duration-300 hover:border-accent hover:bg-accent-light max-[480px]:w-full">Call Us</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="py-22 relative bg-alt">
		<div class="max-w-[1200px] mx-auto px-6 md:px-10">
			<div class="text-center mb-12">
				<div class="section-tag section-tag-center inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.15em] uppercase text-accent mb-4 justify-center reveal">Specifications</div>
				<h2 class="font-display text-[length:clamp(1.8rem,4vw,2.8rem)] font-[400] tracking-[0.01em] leading-tight mb-3 text-text-primary reveal reveal-delay-1">Technical Details</h2>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 border border-divider reveal">
				{
					product.specs.map((spec: { label: string; value: string }, index: number) => (
						<div class:list={['flex justify-between items-center px-6 py-4 border-b border-divider', index % 2 === 0 && 'md:border-r md:border-r-divider']}>
							<div class="text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-text-muted">{spec.label}</div>
							<div class="text-[0.9rem] font-medium text-text-primary text-right">{spec.value}</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<CtaSection
		tag="Get Started"
		title="Ready to Transform Your Space?"
		text="Get your free consultation and quote today. Let us craft the perfect aluminium solution for your home or business."
		primaryHref={company.phoneHref}
		primaryLabel={`Call ${company.phoneDisplay}`}
		secondaryHref="/quote"
		secondaryLabel="Request a Quote"
	/>

	<section class="py-22 relative bg-page">
		<div class="max-w-[1400px] mx-auto px-6 md:px-8">
			<div class="mb-12">
				<div class="section-tag inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.15em] uppercase text-accent mb-4 reveal">Related</div>
				<h2 class="font-display text-[length:clamp(1.8rem,4vw,2.8rem)] font-[400] tracking-[0.01em] leading-tight mb-3 text-text-primary reveal reveal-delay-1">{relatedHeading}</h2>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					relatedProducts.map((relatedProduct, index) => (
						<ProductCard
							product={relatedProduct}
							variant="carousel-card"
							revealClass={index === 0 ? 'reveal' : `reveal reveal-delay-${Math.min(index, 2)}`}
						/>
					))
				}
			</div>
		</div>
	</section>
</Layout>
