---
import CtaSection from '../components/CtaSection.astro';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SocialSection from '../components/SocialSection.astro';
import StatsBar from '../components/StatsBar.astro';
import {
	company,
	doorProducts,
	testimonials,
	windowProducts,
} from '../data/site';
---

<Layout
	title="Aluverse - Premium Aluminium Doors & Windows | Sydney"
	description="Sydney's leading custom aluminium doors and windows specialist. Bespoke fabrication, premium materials and free quotes from Aluverse."
	activeNav="home"
>
	<section class="min-h-[90vh] flex items-center bg-hero text-text-on-dark relative pt-18 overflow-hidden">
		<img
			class="absolute inset-0 w-full h-full object-cover z-0"
			src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1920&q=80"
			alt="Modern home with premium aluminium windows"
			loading="eager"
		/>
		<div class="hero-overlay-gradient absolute inset-0 z-[1]"></div>
		<div class="max-w-[1400px] mx-auto px-8 py-16 md:py-20 w-full relative z-[2]">
			<div class="inline-flex items-center gap-2 px-4 py-1.5 border border-anodise/35 text-[0.7rem] font-semibold tracking-[0.15em] uppercase text-anodise mb-6 reveal before:content-[''] before:w-2 before:h-px before:bg-anodise">Sydney's Premium Choice</div>
			<h1 class="font-display text-[length:clamp(2.5rem,5.5vw,4.2rem)] max-md:text-[length:clamp(2rem,8vw,3rem)] font-[400] tracking-[0.01em] leading-[1.08] mb-6 max-w-[750px] reveal reveal-delay-1">
				Premium Aluminium <em class="not-italic text-anodise">Windows & Doors</em>
			</h1>
			<p class="text-[length:clamp(0.95rem,2vw,1.1rem)] text-white/60 leading-relaxed max-w-[500px] mb-10 font-light reveal reveal-delay-2">
				Meticulously crafted aluminium solutions for Sydney homes. Where architectural
				precision meets enduring quality.
			</p>
			<div class="flex flex-wrap gap-4 max-[480px]:flex-col reveal reveal-delay-3">
				<a href="/quote" class="btn-shine relative overflow-hidden inline-flex items-center justify-center gap-2 px-8 py-3.5 font-body text-[0.85rem] font-semibold tracking-[0.04em] uppercase cursor-pointer bg-accent text-text-on-accent transition-all duration-300 hover:brightness-110 hover:-translate-y-0.5 hover:shadow-[0_8px_30px_var(--color-accent-light)] max-[480px]:w-full">
					Request a Quote
					<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2">
						<path d="M5 12h14M12 5l7 7-7 7"></path>
					</svg>
				</a>
				<a href="/windows" class="btn-shine relative overflow-hidden inline-flex items-center justify-center gap-2 px-8 py-3.5 font-body text-[0.85rem] font-semibold tracking-[0.04em] uppercase cursor-pointer bg-transparent text-text-on-dark border border-white/30 transition-all duration-300 hover:border-white hover:text-white hover:bg-white/10 max-[480px]:w-full">View Products</a>
			</div>
		</div>
		<div class="absolute bottom-10 left-8 z-10 flex items-center gap-3 text-white/35 text-[0.68rem] tracking-[0.15em] uppercase [writing-mode:vertical-rl] max-md:hidden">
			<span class="scroll-line"></span>Scroll
		</div>
	</section>

	<StatsBar />

	<section class="py-22 relative bg-page">
		<div class="max-w-[1400px] mx-auto px-6 md:px-8">
			<div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
				<div>
					<div class="section-tag inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.15em] uppercase text-accent mb-4 reveal">Our Collection</div>
					<h2 class="font-display text-[length:clamp(1.8rem,4vw,2.8rem)] font-[400] tracking-[0.01em] leading-tight mb-3 text-text-primary reveal reveal-delay-1">Aluminium Windows</h2>
					<p class="text-[0.95rem] text-text-secondary max-w-[550px] leading-relaxed reveal reveal-delay-2">
						Precision-engineered window systems for every architectural style.
					</p>
				</div>
				<div class="flex gap-2">
					<button type="button" data-carousel-target="windows-track" data-direction="-1" aria-label="Previous" class="w-12 h-12 border border-divider bg-transparent flex items-center justify-center transition-all duration-300 hover:border-accent hover:bg-accent-light">
						<svg class="w-[18px] h-[18px] stroke-text-primary stroke-2 fill-none" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
					</button>
					<button type="button" data-carousel-target="windows-track" data-direction="1" aria-label="Next" class="w-12 h-12 border border-divider bg-transparent flex items-center justify-center transition-all duration-300 hover:border-accent hover:bg-accent-light">
						<svg class="w-[18px] h-[18px] stroke-text-primary stroke-2 fill-none" viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"></polyline></svg>
					</button>
				</div>
			</div>
			<div class="overflow-hidden reveal">
				<div class="flex gap-6 overflow-x-auto scroll-smooth scrollbar-hide" id="windows-track">
					{
						windowProducts.map((product) => <ProductCard product={product} variant="carousel-card" />)
					}
				</div>
			</div>
			<div class="text-center mt-10 reveal">
				<a href="/windows" class="btn-shine relative overflow-hidden inline-flex items-center justify-center gap-2 px-8 py-3.5 font-body text-[0.85rem] font-semibold tracking-[0.04em] uppercase cursor-pointer bg-transparent text-accent border border-divider transition-all duration-300 hover:border-accent hover:bg-accent-light">
					View All Windows
					<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2">
						<path d="M5 12h14M12 5l7 7-7 7"></path>
					</svg>
				</a>
			</div>
		</div>
	</section>

	<section class="section-dark py-22 relative bg-dark text-text-on-dark">
		<div class="max-w-[1400px] mx-auto px-6 md:px-8">
			<div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
				<div>
					<div class="section-tag inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.15em] uppercase text-anodise mb-4 reveal">Our Collection</div>
					<h2 class="font-display text-[length:clamp(1.8rem,4vw,2.8rem)] font-[400] tracking-[0.01em] leading-tight mb-3 text-text-on-dark reveal reveal-delay-1">Aluminium Doors</h2>
					<p class="text-[0.95rem] text-white/50 max-w-[550px] leading-relaxed reveal reveal-delay-2">
						Secure, elegant door systems engineered for Australian conditions.
					</p>
				</div>
				<div class="flex gap-2">
					<button type="button" data-carousel-target="doors-track" data-direction="-1" aria-label="Previous" class="w-12 h-12 border border-white/[0.12] bg-transparent flex items-center justify-center transition-all duration-300 hover:border-accent hover:bg-accent-light">
						<svg class="w-[18px] h-[18px] stroke-text-on-dark stroke-2 fill-none" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
					</button>
					<button type="button" data-carousel-target="doors-track" data-direction="1" aria-label="Next" class="w-12 h-12 border border-white/[0.12] bg-transparent flex items-center justify-center transition-all duration-300 hover:border-accent hover:bg-accent-light">
						<svg class="w-[18px] h-[18px] stroke-text-on-dark stroke-2 fill-none" viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"></polyline></svg>
					</button>
				</div>
			</div>
			<div class="overflow-hidden reveal">
				<div class="flex gap-6 overflow-x-auto scroll-smooth scrollbar-hide" id="doors-track">
					{
						doorProducts.map((product) => <ProductCard product={product} variant="carousel-card" />)
					}
				</div>
			</div>
			<div class="text-center mt-10 reveal">
				<a href="/doors" class="btn-shine relative overflow-hidden inline-flex items-center justify-center gap-2 px-8 py-3.5 font-body text-[0.85rem] font-semibold tracking-[0.04em] uppercase cursor-pointer bg-transparent text-white border border-white/30 transition-all duration-300 hover:border-white/70 hover:bg-white/5">
					View All Doors
					<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2">
						<path d="M5 12h14M12 5l7 7-7 7"></path>
					</svg>
				</a>
			</div>
		</div>
	</section>

	<section class="py-22 relative bg-dark text-text-on-dark border-t border-stat-border">
		<div class="max-w-[1400px] mx-auto px-6 md:px-8">
			<div class="text-center mb-12">
				<div class="section-tag section-tag-center inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.15em] uppercase text-anodise mb-4 justify-center reveal">What We Do</div>
				<h2 class="font-display text-[length:clamp(1.8rem,4vw,2.8rem)] font-[400] tracking-[0.01em] leading-tight mb-3 text-text-on-dark reveal reveal-delay-1">Our Services</h2>
				<p class="text-[0.95rem] text-white/50 max-w-[550px] leading-relaxed mx-auto reveal reveal-delay-2">
					Comprehensive aluminium solutions from start to finish.
				</p>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				<div class="service-card-line relative overflow-hidden p-10 border border-service-card-border bg-service-card-bg backdrop-blur-[8px] transition-all duration-400 hover:bg-white/5 hover:border-accent-dim hover:-translate-y-1 reveal">
					<div class="w-[52px] h-[52px] border border-anodise/30 flex items-center justify-center mb-6">
						<svg class="w-6 h-6 stroke-anodise stroke-[1.5] fill-none" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"></path></svg>
					</div>
					<h3 class="font-display text-[1.2rem] font-[400] text-text-on-dark mb-3 tracking-[0.01em]">Removal, Supply, Install & Finishing</h3>
					<p class="text-[0.85rem] text-white/45 leading-relaxed">
						Complete end-to-end service from careful removal of existing fixtures to
						professional installation and meticulous finishing touches.
					</p>
				</div>
				<div class="service-card-line relative overflow-hidden p-10 border border-service-card-border bg-service-card-bg backdrop-blur-[8px] transition-all duration-400 hover:bg-white/5 hover:border-accent-dim hover:-translate-y-1 reveal reveal-delay-1">
					<div class="w-[52px] h-[52px] border border-anodise/30 flex items-center justify-center mb-6">
						<svg class="w-6 h-6 stroke-anodise stroke-[1.5] fill-none" viewBox="0 0 24 24">
							<circle cx="12" cy="12" r="3"></circle>
							<path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9c.26.604.852.997 1.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"></path>
						</svg>
					</div>
					<h3 class="font-display text-[1.2rem] font-[400] text-text-on-dark mb-3 tracking-[0.01em]">Repair & Maintenance</h3>
					<p class="text-[0.85rem] text-white/45 leading-relaxed">
						Expert repair services for all aluminium doors and windows, extending the life
						of your fixtures and restoring optimal performance.
					</p>
				</div>
				<div class="service-card-line relative overflow-hidden p-10 border border-service-card-border bg-service-card-bg backdrop-blur-[8px] transition-all duration-400 hover:bg-white/5 hover:border-accent-dim hover:-translate-y-1 reveal reveal-delay-2">
					<div class="w-[52px] h-[52px] border border-anodise/30 flex items-center justify-center mb-6">
						<svg class="w-6 h-6 stroke-anodise stroke-[1.5] fill-none" viewBox="0 0 24 24">
							<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
							<polyline points="9 22 9 12 15 12 15 22"></polyline>
						</svg>
					</div>
					<h3 class="font-display text-[1.2rem] font-[400] text-text-on-dark mb-3 tracking-[0.01em]">Residential Solutions</h3>
					<p class="text-[0.85rem] text-white/45 leading-relaxed">
						Tailored aluminium windows and doors for homes of all styles, from heritage
						renovations to modern new builds.
					</p>
				</div>
				<div class="service-card-line relative overflow-hidden p-10 border border-service-card-border bg-service-card-bg backdrop-blur-[8px] transition-all duration-400 hover:bg-white/5 hover:border-accent-dim hover:-translate-y-1 reveal reveal-delay-3">
					<div class="w-[52px] h-[52px] border border-anodise/30 flex items-center justify-center mb-6">
						<svg class="w-6 h-6 stroke-anodise stroke-[1.5] fill-none" viewBox="0 0 24 24">
							<rect x="2" y="7" width="20" height="14" rx="2"></rect>
							<path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"></path>
						</svg>
					</div>
					<h3 class="font-display text-[1.2rem] font-[400] text-text-on-dark mb-3 tracking-[0.01em]">Commercial Fit-outs</h3>
					<p class="text-[0.85rem] text-white/45 leading-relaxed">
						Engineered aluminium systems for storefronts, offices, and commercial properties
						compliant with Australian building codes.
					</p>
				</div>
				<div class="service-card-line relative overflow-hidden p-10 border border-service-card-border bg-service-card-bg backdrop-blur-[8px] transition-all duration-400 hover:bg-white/5 hover:border-accent-dim hover:-translate-y-1 reveal reveal-delay-4">
					<div class="w-[52px] h-[52px] border border-anodise/30 flex items-center justify-center mb-6">
						<svg class="w-6 h-6 stroke-anodise stroke-[1.5] fill-none" viewBox="0 0 24 24">
							<rect x="3" y="3" width="18" height="18" rx="2"></rect>
							<line x1="3" y1="9" x2="21" y2="9"></line>
							<line x1="9" y1="21" x2="9" y2="9"></line>
						</svg>
					</div>
					<h3 class="font-display text-[1.2rem] font-[400] text-text-on-dark mb-3 tracking-[0.01em]">Single & Double Glazing</h3>
					<p class="text-[0.85rem] text-white/45 leading-relaxed">
						Quality glazing options for optimal thermal performance, noise reduction, and
						energy efficiency in any application.
					</p>
				</div>
				<div class="service-card-line relative overflow-hidden p-10 border border-service-card-border bg-service-card-bg backdrop-blur-[8px] transition-all duration-400 hover:bg-white/5 hover:border-accent-dim hover:-translate-y-1 reveal reveal-delay-5">
					<div class="w-[52px] h-[52px] border border-anodise/30 flex items-center justify-center mb-6">
						<svg class="w-6 h-6 stroke-anodise stroke-[1.5] fill-none" viewBox="0 0 24 24">
							<path d="M12 20h9"></path>
							<path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"></path>
						</svg>
					</div>
					<h3 class="font-display text-[1.2rem] font-[400] text-text-on-dark mb-3 tracking-[0.01em]">Custom Design Consultation</h3>
					<p class="text-[0.85rem] text-white/45 leading-relaxed">
						Free on-site consultations to design bespoke aluminium solutions that match your
						exact architectural vision.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="py-22 relative bg-alt">
		<div class="max-w-[1400px] mx-auto px-6 md:px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-16 max-md:gap-8 items-center">
				<div class="about-img-decorator aspect-[6/5] relative overflow-hidden max-md:after:hidden reveal">
					<img
						src="https://images.unsplash.com/photo-1547555706-54bcf05bbad1?w=1200&q=80"
						alt="Aluminium fabrication workshop"
						loading="lazy"
						class="w-full h-full object-cover"
					/>
				</div>
				<div class="reveal reveal-delay-1">
					<div class="mb-12">
						<div class="section-tag inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.15em] uppercase text-accent mb-4">Who We Are</div>
						<h2 class="font-display text-[length:clamp(1.8rem,4vw,2.8rem)] font-[400] tracking-[0.01em] leading-tight mb-3 text-text-primary">A Decade of Precision Craftsmanship</h2>
						<p class="text-[0.95rem] text-text-secondary max-w-[550px] leading-relaxed">
							With over a decade of experience, Aluverse delivers full-service aluminium
							solutions tailored to your residential and commercial needs.
						</p>
					</div>
					<ul class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-8">
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Full-service:
							removal, supply, install, finishing
						</li>
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Residential &
							commercial expertise
						</li>
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Single &
							double glazing options
						</li>
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Australian
							Standards compliant
						</li>
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Custom designs
							to your specification
						</li>
						<li class="flex items-start gap-2.5 text-[0.88rem] text-text-secondary">
							<svg class="w-[18px] h-[18px] stroke-accent stroke-2 fill-none shrink-0 mt-0.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>Local Sydney
							knowledge & expertise
						</li>
					</ul>
					<div class="mt-8">
						<a href="/about" class="btn-shine relative overflow-hidden inline-flex items-center justify-center gap-2 px-8 py-3.5 font-body text-[0.85rem] font-semibold tracking-[0.04em] uppercase cursor-pointer bg-transparent text-accent border border-divider transition-all duration-300 hover:border-accent hover:bg-accent-light">
							Learn More About Us
							<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2">
								<path d="M5 12h14M12 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="py-22 relative bg-page">
		<div class="max-w-[1200px] mx-auto px-6 md:px-10">
			<div class="text-center mb-12">
				<div class="section-tag section-tag-center inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.15em] uppercase text-accent mb-4 justify-center reveal">Client Feedback</div>
				<h2 class="font-display text-[length:clamp(1.8rem,4vw,2.8rem)] font-[400] tracking-[0.01em] leading-tight mb-3 text-text-primary reveal reveal-delay-1">What Our Clients Say</h2>
				<p class="text-[0.95rem] text-text-secondary max-w-[550px] leading-relaxed mx-auto reveal reveal-delay-2">
					Trusted by Sydney homeowners and businesses alike.
				</p>
			</div>
			<div class="max-w-[800px] mx-auto relative overflow-hidden reveal">
				<div class="flex transition-transform duration-600 ease-[cubic-bezier(0.4,0,0.2,1)]" id="testimonialTrack">
					{
						testimonials.map((testimonial) => (
							<div class="min-w-full px-4">
								<div class="text-center p-12 max-md:p-8 bg-testimonial-bg border border-testimonial-border">
									<div class="flex justify-center gap-1 mb-6">
										{Array.from({ length: 5 }).map(() => (
											<svg class="w-[18px] h-[18px] fill-accent" viewBox="0 0 24 24">
												<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
											</svg>
										))}
									</div>
									<p class="font-display text-[1.3rem] font-normal italic leading-relaxed mb-6 text-text-primary">"{testimonial.quote}"</p>
									<div class="text-[0.85rem] font-bold">{testimonial.author}</div>
									<div class="text-[0.8rem] text-text-muted mt-1">{testimonial.location}</div>
								</div>
							</div>
						))
					}
				</div>
				<div class="flex justify-center gap-2 mt-6">
					{
						testimonials.map((_, index) => (
							<button
								type="button"
								class:list={['testimonial-dot w-2 h-2 rounded-full border border-text-muted bg-transparent p-0 cursor-pointer transition-all duration-300', index === 0 && 'active']}
								data-testimonial-dot
								aria-label={`Testimonial ${index + 1}`}
							></button>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<CtaSection
		tag="Get Started"
		title="Ready to Transform Your Space?"
		text="Get your free consultation and quote today. Let us craft the perfect aluminium solution for your home or business."
		primaryHref={company.phoneHref}
		primaryLabel={`Call ${company.phoneDisplay}`}
		secondaryHref="/quote"
		secondaryLabel="Request a Quote"
	/>

	<SocialSection />
</Layout>
