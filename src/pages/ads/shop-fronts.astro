---
import { Image, Picture } from "astro:assets";
import AdLayout from "../../layouts/AdLayout.astro";
import AdSharedSections from "../../components/AdSharedSections.astro";
import StatsBar from "../../components/StatsBar.astro";
import PartnerLogosMarquee from "../../components/PartnerLogosMarquee.astro";
import { productImages } from "../../assets/images";
import { company, getProductBySlug } from "../../data/site";

const product = getProductBySlug("shop-fronts");
if (!product) throw new Error("shop-fronts product missing");

const heroWidths = [768, 1024, 1440, 1920];
const featureImageWidths = [480, 768, 960, 1280];
const heroQuality = 66;
const featureImageQuality = 62;

const whyItems = [
    {
        title: "Shopfront Glazing",
        text: "Slim-framed aluminium shopfront glazing and fixed display windows that maximise the glass, frame the products inside, and give your tenancy a clean, modern street presence.",
    },
    {
        title: "Entrance Doors",
        text: "Framed and frameless aluminium entrance doors with commercial-grade closers and multi-point locking, built for the foot traffic of busy retail and hospitality venues.",
    },
    {
        title: "Toughened & Laminated Glass",
        text: "Safety glass glazed to AS 1288, with toughened or laminated options specified for security, acoustic comfort, and compliance at street level.",
    },
    {
        title: "Measured & Installed On Site",
        text: "Every shop front is measured on site, fabricated to the exact opening, and installed by our own team with minimal disruption to your trading hours.",
    },
    {
        title: "Single Point of Accountability",
        text: "Design, shop drawings, fabrication, and installation managed by one team, coordinated with your builder, shopfitter, and tenant.",
    },
    {
        title: "Powder-Coat & Anodised Finishes",
        text: "Full powder-coat colour range and anodised finish options to match your brand, signage, and the surrounding building.",
    },
];

---

<AdLayout
    title="Aluminium Shop Fronts Sydney | Commercial Shopfront Glazing | Aluverse"
    description="Aluminium shop fronts, shopfront glazing, and commercial entrance doors for Sydney retail and hospitality projects. Slim-framed glazing and toughened glass, fabricated and installed."
    canonical="/ads/shop-fronts"
    ogImage={product.heroImage}
>
    <!-- Hero -->
    <section
        class="min-h-[90vh] flex items-center text-white relative pt-16 overflow-hidden"
    >
        <Picture
            src={product.heroImage}
            alt="Aluminium shop front on a Sydney commercial tenancy"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={heroWidths}
            sizes="100vw"
            quality={heroQuality}
            loading="eager"
            fetchpriority="high"
            pictureAttributes={{
                class: "absolute inset-0 block h-full w-full",
            }}
            class="h-full w-full object-cover"
        />
        <div
            class="absolute inset-0 bg-linear-to-r from-black/85 via-black/65 to-black/55"
        >
        </div>
        <div class="max-w-7xl mx-auto px-6 py-12 lg:py-20 w-full relative z-10">
            <div>
                <div class="max-w-3xl text-shadow-hero">
                    <p
                        class="text-xs font-semibold tracking-widest uppercase text-anodise mb-6"
                    >
                        Shopfront Glazing & Entrance Contractors
                    </p>
                    <h1
                        class="font-display text-4xl md:text-5xl lg:text-6xl leading-[1.08] mb-6"
                    >
                        Aluminium Shop Fronts in <em
                            class="not-italic text-anodise">Sydney</em
                        >
                    </h1>
                    <p
                        class="text-lg text-white/90 leading-relaxed max-w-lg mb-10"
                    >
                        Slim-framed shopfront glazing, display windows, and
                        commercial entrance doors for retail and hospitality
                        tenancies. One specialist Sydney team for design,
                        fabrication, and on-site installation.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href={company.phoneHref}
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase bg-white text-dark hover:bg-anodise hover:text-dark transition-colors inline-flex items-center gap-2"
                        >
                            Call Now
                            <svg
                                viewBox="0 0 24 24"
                                class="size-4 stroke-current fill-none stroke-2"
                                ><path
                                    d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"
                                ></path></svg
                            >
                        </a>
                        <a
                            href="#quote"
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase border border-white/60 hover:border-white hover:bg-white/15 transition-all"
                            >Discuss a Project</a
                        >
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats -->
    <StatsBar />

    <!-- Service detail -->
    <section class="py-20 bg-page">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div>
                    <p
                        class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                    >
                        Commercial Shopfront Solutions
                    </p>
                    <h2
                        class="font-display text-3xl md:text-4xl leading-tight mb-4"
                    >
                        Shopfront Glazing, Display Windows & Entrances
                    </h2>
                    <p class="text-sm text-text-secondary leading-relaxed mb-6">
                        Aluverse designs, fabricates, and installs aluminium shop
                        fronts for retail, hospitality, and commercial tenancies
                        across Sydney. As shopfront glazing contractors, we
                        detail slim-framed glazing, fixed display windows, and
                        framed or frameless entrance doors to suit your opening,
                        with toughened or laminated safety glass and powder-coat
                        or anodised finishes. Glazing is specified to AS 1288 and
                        framing to AS 2047 where applicable, with commercial-grade
                        hardware and multi-point locking sized for foot traffic
                        and security. Every shop front is measured on site,
                        fabricated to the exact opening, and installed by our own
                        team with minimal disruption to trading.
                    </p>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
                        {
                            product.features.map(item => (
                                <li class="flex items-start gap-2.5 text-sm text-text-secondary">
                                    <svg
                                        class="size-4 stroke-accent stroke-2 fill-none shrink-0 mt-0.5"
                                        viewBox="0 0 24 24"
                                    >
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    {item}
                                </li>
                            ))
                        }
                    </ul>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href={company.phoneHref}
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase bg-accent text-white hover:bg-accent-hover transition-colors inline-flex items-center gap-2"
                        >
                            Call {company.phoneDisplay}
                        </a>
                        <a
                            href="#quote"
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase text-accent border border-divider hover:border-accent hover:bg-accent-light transition-all"
                        >
                            Discuss a Project
                        </a>
                    </div>
                </div>
                <div
                    class="aspect-6/5 overflow-hidden border-t-[3px] border-t-anodise"
                >
                    <Image
                        src={productImages.aluminiumShopFronts.card}
                        alt="Aluminium shop front glazing and entrance doors"
                        widths={featureImageWidths}
                        sizes="(min-width: 768px) calc((min(100vw, 80rem) - 7.5rem) / 2), calc(100vw - 3rem)"
                        quality={featureImageQuality}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Partner logos -->
    <PartnerLogosMarquee exclude={["Whitco", "A Grade Aluminium & Glass"]} />

    <!-- Specs -->
    <section class="py-20 bg-alt">
        <div class="max-w-7xl mx-auto px-6">
            <div class="max-w-2xl mb-10">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    System Capabilities
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-3"
                >
                    Engineered to Australian Standards
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                    Each shop front is engineered project-specific. Here is the
                    technical envelope our shopfront systems work within.
                </p>
            </div>
            <div
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-divider border border-divider"
            >
                {
                    product.specs.map(spec => (
                        <div class="p-6 bg-white">
                            <p class="text-xs font-semibold tracking-widest uppercase text-text-muted mb-2">
                                {spec.label}
                            </p>
                            <p class="font-display text-xl">{spec.value}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <AdSharedSections
        whyTag="What We Do"
        whyTitle="Why Sydney Chooses Aluverse for Shop Fronts"
        whyText="A specialist shopfront glazing contractor handling design, fabrication, and on-site installation for shopfront glazing, display windows, and entrance scopes."
        whyItems={whyItems}
        quoteTag="Get Started"
        quoteTitle="Ready To Discuss Your Shop Front?"
        quoteText="Share your opening sizes, drawings, or photos; we'll review and quote a shop front tailored to your tenancy."
    />
</AdLayout>
