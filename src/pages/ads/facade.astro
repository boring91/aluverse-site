---
import { Image, Picture } from "astro:assets";
import AdLayout from "../../layouts/AdLayout.astro";
import AdSharedSections from "../../components/AdSharedSections.astro";
import StatsBar from "../../components/StatsBar.astro";
import PartnerLogosMarquee from "../../components/PartnerLogosMarquee.astro";
import { productImages } from "../../assets/images";
import { company, getProductBySlug } from "../../data/site";
import { getFaqSchema } from "../../lib/seo";

const product = getProductBySlug("aluminium-facade-systems");
if (!product) throw new Error("aluminium-facade-systems product missing");

const heroWidths = [768, 1024, 1440, 1920];
const featureImageWidths = [480, 768, 960, 1280];
const heroQuality = 66;
const featureImageQuality = 62;

const adFaqs = product.seoFaqs;
const adSchema = [getFaqSchema([...adFaqs])];

const whyItems = [
    {
        title: "Curtain Wall Installation",
        text: "Stick-built and unitised curtain wall installation with front-glazed (externally retained) and center-glazed (pocket-set) options, captive or silicone-bonded to your structural grid and architect intent.",
    },
    {
        title: "Thermally Broken Framing",
        text: "Aluminium framing with thermal breaks for energy performance, condensation control, and compliance with modern building briefs.",
    },
    {
        title: "Shopfront Glazing Contractors",
        text: "Commercial shopfront glazing with slim aluminium framing, toughened glass, and entrance doors detailed for high-traffic retail and ground-floor tenancies.",
    },
    {
        title: "AS/NZS 4284 Performance",
        text: "Systems designed and documented to AS/NZS 4284 with structural, thermal, and weatherproofing performance verified for your project.",
    },
    {
        title: "Single Point of Accountability",
        text: "Design development, shop drawings, fabrication, and on-site installation managed by one team, coordinated with your head contractor.",
    },
    {
        title: "Powder-Coat & Anodised Finishes",
        text: "Full powder-coat colour range and anodised finish options to match the architect's palette across mid-rise and high-rise builds.",
    },
];

const aboutBullets = [
    "Mid-rise commercial expertise",
    "Multi-residential developments",
    "Architectural refurbishments",
    "Designed to AS/NZS 4284",
    "Coordinated with head contractor",
    "Shop drawings & compliance docs",
];
---

<AdLayout
    title="Aluminium Facade Systems Sydney | Curtain Wall Installation | Aluverse"
    description="Aluminium facade systems, facade glazing, curtain wall installation, structural glazing contractors, and shopfront glazing for Sydney commercial projects."
    canonical="/ads/facade"
    ogImage={product.heroImage}
    schema={adSchema}
>
    <!-- Hero -->
    <section
        class="min-h-[90vh] flex items-center text-white relative pt-16 overflow-hidden"
    >
        <Picture
            src={product.heroImage}
            alt="Aluminium facade system on a Sydney commercial building"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={heroWidths}
            sizes="100vw"
            quality={heroQuality}
            loading="eager"
            fetchpriority="high"
            pictureAttributes={{
                class: "absolute inset-0 block h-full w-full",
            }}
            class="h-full w-full object-cover"
        />
        <div
            class="absolute inset-0 bg-linear-to-r from-black/85 via-black/65 to-black/55"
        >
        </div>
        <div class="max-w-7xl mx-auto px-6 py-12 lg:py-20 w-full relative z-10">
            <div>
                <div class="max-w-3xl text-shadow-hero">
                    <p
                        class="text-xs font-semibold tracking-widest uppercase text-anodise mb-6"
                    >
                        Facade Glazing, Curtain Wall & Shopfront Contractors
                    </p>
                    <h1
                        class="font-display text-4xl md:text-5xl lg:text-6xl leading-[1.08] mb-6"
                    >
                        Aluminium Facade Systems in <em
                            class="not-italic text-anodise">Sydney</em
                        >
                    </h1>
                    <p
                        class="text-lg text-white/90 leading-relaxed max-w-lg mb-10"
                    >
                        Curtain wall installation, structural glazing
                        contractors, facade glazing, and shopfront glazing for
                        commercial and multi-residential builds. One specialist
                        Sydney team for design, shop drawings, fabrication, and
                        on-site installation.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href={company.phoneHref}
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase bg-white text-dark hover:bg-anodise hover:text-dark transition-colors inline-flex items-center gap-2"
                        >
                            Call Now
                            <svg
                                viewBox="0 0 24 24"
                                class="size-4 stroke-current fill-none stroke-2"
                                ><path
                                    d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"
                                ></path></svg
                            >
                        </a>
                        <a
                            href="#quote"
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase border border-white/60 hover:border-white hover:bg-white/15 transition-all"
                            >Discuss a Project</a
                        >
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats -->
    <StatsBar />

    <!-- Service detail -->
    <section class="py-20 bg-page">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div>
                    <p
                        class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                    >
                        Architectural Facade Solutions
                    </p>
                    <h2
                        class="font-display text-3xl md:text-4xl leading-tight mb-4"
                    >
                        Curtain Wall, Structural Glazing & Cladding
                    </h2>
                    <p class="text-sm text-text-secondary leading-relaxed mb-6">
                        Aluverse engineers aluminium facade envelopes for
                        commercial, multi-residential, and architectural
                        projects across Sydney. As facade glazing contractors,
                        we detail curtain wall, structural silicone glazing,
                        glass facade installation, and shopfront glazing to suit
                        your structural grid, with thermally broken framing and
                        powder-coat or anodised finishes. We specify both
                        front-glazed (externally retained) and center-glazed
                        (pocket-set) IGUs; front glazing for the clean external
                        sightlines of curtain wall and high-rise facades, center
                        glazing for shop fronts and ground-floor facades where
                        the inside trim is on show. Every installation comes
                        with shop drawings, AS/NZS performance documentation,
                        and on-site coordination.
                    </p>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
                        {
                            product.features.map(item => (
                                <li class="flex items-start gap-2.5 text-sm text-text-secondary">
                                    <svg
                                        class="size-4 stroke-accent stroke-2 fill-none shrink-0 mt-0.5"
                                        viewBox="0 0 24 24"
                                    >
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    {item}
                                </li>
                            ))
                        }
                    </ul>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href={company.phoneHref}
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase bg-accent text-white hover:bg-accent-hover transition-colors inline-flex items-center gap-2"
                        >
                            Call {company.phoneDisplay}
                        </a>
                        <a
                            href="#quote"
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase text-accent border border-divider hover:border-accent hover:bg-accent-light transition-all"
                        >
                            Discuss a Project
                        </a>
                    </div>
                </div>
                <div
                    class="aspect-6/5 overflow-hidden border-t-[3px] border-t-anodise"
                >
                    <Image
                        src={productImages.aluminiumFacades.card}
                        alt="Aluminium facade panels and curtain wall framing"
                        widths={featureImageWidths}
                        sizes="(min-width: 768px) calc((min(100vw, 80rem) - 7.5rem) / 2), calc(100vw - 3rem)"
                        quality={featureImageQuality}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Partner logos -->
    <PartnerLogosMarquee exclude={["Whitco"]} />

    <!-- Specs -->
    <section class="py-20 bg-alt">
        <div class="max-w-7xl mx-auto px-6">
            <div class="max-w-2xl mb-10">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    System Capabilities
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-3"
                >
                    Engineered to Australian Standards
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                    Each facade is engineered project-specific. Here is the
                    technical envelope our standard facade systems work within.
                </p>
            </div>
            <div
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-divider border border-divider"
            >
                {
                    product.specs.map(spec => (
                        <div class="p-6 bg-white">
                            <p class="text-xs font-semibold tracking-widest uppercase text-text-muted mb-2">
                                {spec.label}
                            </p>
                            <p class="font-display text-xl">{spec.value}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 bg-white border-y border-divider">
        <div class="max-w-7xl mx-auto px-6">
            <div class="max-w-3xl mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Common Questions
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-4"
                >
                    Aluminium Facade Systems in Sydney
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                    Practical answers to the questions architects, builders, and
                    developers ask before specifying a facade system.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {
                    adFaqs.map(faq => (
                        <article class="p-8 border border-divider bg-page">
                            <h3 class="font-display text-xl mb-3">
                                {faq.question}
                            </h3>
                            <p class="text-sm text-text-secondary leading-relaxed">
                                {faq.answer}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <AdSharedSections
        whyTag="What We Do"
        whyTitle="Why Sydney Specifies Aluverse for Facades"
        whyText="A specialist facade glazing contractor handling design, shop drawings, fabrication, and on-site installation for curtain wall, structural glazing, and shopfront scopes."
        whyItems={whyItems}
        aboutTitle="A Decade of Architectural Aluminium Delivery"
        aboutText="Aluverse delivers facade systems for boutique mixed-use developments through to commercial fitouts and multi-residential builds across Sydney."
        aboutBullets={aboutBullets}
        quoteTag="Get Started"
        quoteTitle="Ready To Discuss Your Facade?"
        quoteText="Share your drawings and performance brief; we'll review and quote a system tailored to your project."
    />
</AdLayout>
