---
import { Image, Picture } from "astro:assets";
import AdLayout from "../../layouts/AdLayout.astro";
import AdHeroQuoteForm from "../../components/AdHeroQuoteForm.astro";
import AdSharedSections from "../../components/AdSharedSections.astro";
import StatsBar from "../../components/StatsBar.astro";
import PartnerLogosMarquee from "../../components/PartnerLogosMarquee.astro";
import { productImages } from "../../assets/images";
import { company, getProductBySlug } from "../../data/site";
import { getFaqSchema } from "../../lib/seo";

const product = getProductBySlug("sliding-windows");
if (!product) throw new Error("sliding-windows product missing");

const heroWidths = [768, 1024, 1440, 1920];
const featureImageWidths = [480, 768, 960, 1280];
const heroQuality = 66;
const featureImageQuality = 62;

const adFaqs = product.seoFaqs;
const adSchema = [getFaqSchema([...adFaqs])];

const whyItems = [
    {
        title: "Supply, Install & Replacement",
        text: "Every sliding window is measured, supplied, and installed to the exact dimensions of the opening, including replacement windows for renovations and upgrades.",
    },
    {
        title: "Maximum Daylight",
        text: "Slim aluminium frames keep glass-to-frame ratios high so rooms benefit from as much natural light as the opening allows.",
    },
    {
        title: "Single-Hand Operation",
        text: "Smooth horizontal sashes glide on quality tracks installed level and square; intuitive for everyday ventilation and easy enough for any household.",
    },
    {
        title: "No Outward Swing",
        text: "Sashes stay inside the frame, leaving paths, decks, and garden beds clear; ideal for tight clearances and exterior walkways.",
    },
    {
        title: "Sealed for Sydney",
        text: "Weather seals and drainage are detailed for Sydney's coastal humidity, summer heat, and unpredictable rain.",
    },
    {
        title: "Single or Double Glazing",
        text: "Specify the glazing that suits your project; double glazing for thermal comfort and noise control, single for budget builds.",
    },
];

const aboutBullets = [
    "Over a decade of Sydney aluminium experience",
    "Residential, multi-residential & commercial",
    "Single & double glazing options",
    "Australian Standards compliant",
    "Multi-panel configurations available",
    "Full powder-coat colour range",
];
---

<AdLayout
    title="Aluminium Sliding Window Installation Sydney | Custom Windows | Aluverse"
    description="Aluminium sliding window installation, replacement, supply, and prices for Sydney homes and commercial projects. Custom made and professionally installed."
    canonical="/ads/sliding-windows"
    ogImage={product.heroImage}
    schema={adSchema}
>
    <!-- Hero -->
    <section
        class="min-h-[90vh] flex items-center text-white relative pt-16 overflow-hidden"
    >
        <Picture
            src={product.heroImage}
            alt="Aluminium sliding windows on a Sydney home"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={heroWidths}
            sizes="100vw"
            quality={heroQuality}
            loading="eager"
            fetchpriority="high"
            pictureAttributes={{
                class: "absolute inset-0 block h-full w-full",
            }}
            class="h-full w-full object-cover"
        />
        <div
            class="absolute inset-0 bg-linear-to-r from-black/85 via-black/65 to-black/55"
        >
        </div>
        <div class="max-w-7xl mx-auto px-6 py-12 lg:py-20 w-full relative z-10">
            <div
                class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(380px,480px)] lg:items-center"
            >
                <div class="max-w-3xl text-shadow-hero">
                    <p
                        class="text-xs font-semibold tracking-widest uppercase text-anodise mb-6"
                    >
                        Sliding Window Installation, Replacement & Supply
                    </p>
                    <h1
                        class="font-display text-4xl md:text-5xl lg:text-6xl leading-[1.08] mb-6"
                    >
                        Aluminium Sliding Window Installation <em
                            class="not-italic text-anodise">Sydney</em
                        >
                    </h1>
                    <p
                        class="text-lg text-white/90 leading-relaxed max-w-lg mb-10"
                    >
                        Custom aluminium sliding windows supplied and installed
                        for Sydney homes, apartments, renovations, and
                        commercial projects. Get smooth horizontal panels, slim
                        frames, measured-to-fit replacement windows, and clear
                        pricing from a local installation team.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href={company.phoneHref}
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase bg-white text-dark hover:bg-anodise hover:text-dark transition-colors inline-flex items-center gap-2"
                        >
                            Call Now
                            <svg
                                viewBox="0 0 24 24"
                                class="size-4 stroke-current fill-none stroke-2"
                                ><path
                                    d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"
                                ></path></svg
                            >
                        </a>
                        <a
                            href="#sliding-windows-hero-quote"
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase border border-white/60 hover:border-white hover:bg-white/15 transition-all"
                            >Get Free Quote</a
                        >
                    </div>
                </div>
                <AdHeroQuoteForm
                    tag="Free Sydney Quote"
                    title="Get a Sliding Window Installation Quote"
                    text="Send your details now and we will price your sliding window supply, install, or replacement project."
                    formIdPrefix="sliding-windows-hero-quote"
                    defaultInterest="windows"
                />
            </div>
        </div>
    </section>

    <!-- Stats -->
    <StatsBar />

    <!-- Service detail -->
    <section class="py-20 bg-page">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div>
                    <p
                        class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                    >
                        Engineered Sliding Window Systems
                    </p>
                    <h2
                        class="font-display text-3xl md:text-4xl leading-tight mb-4"
                    >
                        Daily Ventilation, Effortless Operation.
                    </h2>
                    <p class="text-sm text-text-secondary leading-relaxed mb-6">
                        Aluminium sliding windows give you smooth horizontal
                        operation along precision tracks, no outward projection,
                        and clean sightlines across wide openings. Our Sydney
                        installation team measures each opening, supplies the
                        custom aluminium frame, and fits the window so the
                        sashes, seals, and drainage perform properly from day
                        one. Sliding windows suit bedrooms, kitchens, and
                        living areas where easy day-to-day airflow matters; and
                        they sit comfortably beside decks and walkways without
                        obstructing foot traffic. Single panels can be
                        fabricated up to 3600 mm wide and 2400 mm high;
                        multi-track configurations cover even larger openings.
                    </p>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
                        {
                            product.features.map(item => (
                                <li class="flex items-start gap-2.5 text-sm text-text-secondary">
                                    <svg
                                        class="size-4 stroke-accent stroke-2 fill-none shrink-0 mt-0.5"
                                        viewBox="0 0 24 24"
                                    >
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    {item}
                                </li>
                            ))
                        }
                    </ul>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href={company.phoneHref}
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase bg-accent text-white hover:bg-accent-hover transition-colors inline-flex items-center gap-2"
                        >
                            Call {company.phoneDisplay}
                        </a>
                        <a
                            href="#quote"
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase text-accent border border-divider hover:border-accent hover:bg-accent-light transition-all"
                        >
                            Request a Quote
                        </a>
                    </div>
                </div>
                <div
                    class="aspect-6/5 overflow-hidden border-t-[3px] border-t-anodise"
                >
                    <Image
                        src={productImages.slidingWindows.card}
                        alt="Aluminium sliding window with slim frame"
                        widths={featureImageWidths}
                        sizes="(min-width: 768px) calc((min(100vw, 80rem) - 7.5rem) / 2), calc(100vw - 3rem)"
                        quality={featureImageQuality}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Partner logos -->
    <PartnerLogosMarquee />

    <!-- Specs -->
    <section class="py-20 bg-alt">
        <div class="max-w-7xl mx-auto px-6">
            <div class="max-w-2xl mb-10">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Specifications
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-3"
                >
                    Built To Order, To Australian Standards
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                    Every sliding window is custom fabricated to suit your
                    opening. Here is the technical envelope our standard sliding
                    window systems work within.
                </p>
            </div>
            <div
                class={`grid grid-cols-1 sm:grid-cols-2 ${product.specs.length > 4 ? "lg:grid-cols-3" : ""} gap-px bg-divider border border-divider`}
            >
                {
                    product.specs.map(spec => (
                        <div class="p-6 bg-white">
                            <p class="text-xs font-semibold tracking-widest uppercase text-text-muted mb-2">
                                {spec.label}
                            </p>
                            <p class="font-display text-xl">{spec.value}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 bg-white border-y border-divider">
        <div class="max-w-7xl mx-auto px-6">
            <div class="max-w-3xl mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Common Questions
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-4"
                >
                    Aluminium Sliding Windows in Sydney
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                    Practical answers to the questions most Sydney homeowners
                    and builders ask before specifying a sliding window system.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {
                    adFaqs.map(faq => (
                        <article class="p-8 border border-divider bg-page">
                            <h3 class="font-display text-xl mb-3">
                                {faq.question}
                            </h3>
                            <p class="text-sm text-text-secondary leading-relaxed">
                                {faq.answer}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <AdSharedSections
        whyTag="What We Do"
        whyTitle="Why Sydney Chooses Aluverse for Sliding Windows"
        whyText="A specialist sliding window contractor handling every step from measurement and design through to professional installation, replacement, and finish."
        whyItems={whyItems}
        aboutTitle="A Decade of Precision Sliding Window Craftsmanship"
        aboutText="Aluverse fabricates and installs custom aluminium sliding windows across Sydney; from single-home renovations through to multi-unit residential and commercial projects."
        aboutBullets={aboutBullets}
        quoteTag="Get Started"
        quoteTitle="Ready For Your New Sliding Windows?"
        quoteText="Tell us about your project; sizes, finishes, timing. We'll respond with a tailored quote within 24 hours."
    />
</AdLayout>
