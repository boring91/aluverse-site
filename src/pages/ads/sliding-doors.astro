---
import { Image, Picture } from "astro:assets";
import AdLayout from "../../layouts/AdLayout.astro";
import AdHeroQuoteForm from "../../components/AdHeroQuoteForm.astro";
import AdSharedSections from "../../components/AdSharedSections.astro";
import StatsBar from "../../components/StatsBar.astro";
import PartnerLogosMarquee from "../../components/PartnerLogosMarquee.astro";
import { productImages } from "../../assets/images";
import { company, getProductBySlug } from "../../data/site";
import { getFaqSchema } from "../../lib/seo";

const slidingProduct = getProductBySlug("sliding-doors");
const stackingProduct = getProductBySlug("stacking-doors");
if (!slidingProduct) throw new Error("sliding-doors product missing");
if (!stackingProduct) throw new Error("stacking-doors product missing");

const heroWidths = [768, 1024, 1440, 1920];
const featureImageWidths = [480, 768, 960, 1280];
const heroQuality = 66;
const featureImageQuality = 62;

const renameStacking = (text: string) =>
    text
        .replaceAll("Stacking doors", "Stacker doors")
        .replaceAll("stacking doors", "stacker doors")
        .replaceAll("Stacking door", "Stacker door")
        .replaceAll("stacking door", "stacker door");

const adFaqs = [
    ...slidingProduct.seoFaqs.slice(0, 3),
    {
        question:
            "Should I choose sliding doors or stacker doors?",
        answer:
            "Sliding doors are ideal for everyday openings where two or three panels glide past each other; they are space-efficient and budget-friendly. Stacker doors use multiple parallel tracks so up to six panels stack behind one another, clearing far wider openings for indoor-outdoor living and large-format architectural projects.",
    },
    ...stackingProduct.seoFaqs.slice(1, 4).map(faq => ({
        question: renameStacking(faq.question),
        answer: renameStacking(faq.answer),
    })),
    slidingProduct.seoFaqs[4],
];
const adSchema = [getFaqSchema([...adFaqs])];

const whyItems = [
    {
        title: "Supply, Install & Replacement",
        text: "Every sliding and stacker door is measured, fabricated, supplied, and installed to the exact dimensions of your opening, including replacement sliding door projects.",
    },
    {
        title: "Slim Sightlines, Big Glass",
        text: "Aluminium frames keep the glass area maximised and the sightlines minimal, so views and natural light come through without visual interruption.",
    },
    {
        title: "Whisper-Quiet Operation",
        text: "Precision-engineered tracks and quality rollers are installed level and square for smooth, low-effort gliding that holds up after thousands of cycles.",
    },
    {
        title: "Wide-Span Stacker Configurations",
        text: "Multi-rail stacker systems let up to six panels slide and stack in a single plane, clearing wide openings without the folding mechanism of a bi-fold.",
    },
    {
        title: "Multi-Point Locking",
        text: "Heavy-duty locking hardware secures each panel at multiple points along the frame for genuine resistance against forced entry.",
    },
    {
        title: "Sealed for Sydney Conditions",
        text: "Weather seals and drainage channels are detailed for Sydney's coastal humidity, summer heat, and wind-driven rain.",
    },
];

const aboutBullets = [
    "Over a decade of Sydney aluminium experience",
    "Sliding and stacker systems engineered together",
    "Residential, multi-residential & commercial",
    "Single & double glazing options",
    "Two, three, and multi-rail stacker configurations",
    "Full powder-coat colour range",
];
---

<AdLayout
    title="Custom Aluminium Sliding Doors Sydney | Installation & Replacement | Aluverse"
    description="Custom aluminium sliding door installation and replacement in Sydney. Sliding glass doors, stacker doors, suppliers, and installers for homes and commercial projects."
    canonical="/ads/sliding-doors"
    ogImage={slidingProduct.heroImage}
    schema={adSchema}
>
    <!-- Hero -->
    <section
        class="min-h-[90vh] flex items-center text-white relative pt-16 overflow-hidden"
    >
        <Picture
            src={slidingProduct.heroImage}
            alt="Custom aluminium sliding and stacker doors opening to a Sydney patio"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={heroWidths}
            sizes="100vw"
            quality={heroQuality}
            loading="eager"
            fetchpriority="high"
            pictureAttributes={{
                class: "absolute inset-0 block h-full w-full",
            }}
            class="h-full w-full object-cover"
        />
        <div
            class="absolute inset-0 bg-linear-to-r from-black/85 via-black/65 to-black/55"
        >
        </div>
        <div class="max-w-7xl mx-auto px-6 py-12 lg:py-20 w-full relative z-10">
            <div
                class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(380px,480px)] lg:items-center"
            >
                <div class="max-w-3xl text-shadow-hero">
                    <p
                        class="text-xs font-semibold tracking-widest uppercase text-anodise mb-6"
                    >
                        Sliding Door Installation, Replacement & Supply
                    </p>
                    <h1
                        class="font-display text-4xl md:text-5xl lg:text-6xl leading-[1.08] mb-6"
                    >
                        Custom Aluminium Sliding Doors in <em
                            class="not-italic text-anodise">Sydney</em
                        >
                    </h1>
                    <p
                        class="text-lg text-white/90 leading-relaxed max-w-lg mb-10"
                    >
                        Professional sliding door installation and replacement
                        for Sydney homes, renovations, commercial fitouts, and
                        large openings. Choose slim aluminium sliding glass
                        doors or wide-span stacker doors, measured, fabricated,
                        and installed by one local team.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href={company.phoneHref}
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase bg-white text-dark hover:bg-anodise hover:text-dark transition-colors inline-flex items-center gap-2"
                        >
                            Call Now
                            <svg
                                viewBox="0 0 24 24"
                                class="size-4 stroke-current fill-none stroke-2"
                                ><path
                                    d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"
                                ></path></svg
                            >
                        </a>
                        <a
                            href="#quote"
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase border border-white/60 hover:border-white hover:bg-white/15 transition-all"
                            >Get Free Quote</a
                        >
                    </div>
                </div>
                <AdHeroQuoteForm
                    tag="Free Sydney Quote"
                    title="Get a Sliding Door Installation Quote"
                    text="Send your details now and we will price your sliding door, stacker door, or replacement project."
                    formIdPrefix="sliding-doors-hero-quote"
                    defaultInterest="doors"
                />
            </div>
        </div>
    </section>

    <!-- Stats -->
    <StatsBar />

    <!-- Service detail -->
    <section class="py-20 bg-page">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div>
                    <p
                        class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                    >
                        Engineered Sliding & Stacker Door Systems
                    </p>
                    <h2
                        class="font-display text-3xl md:text-4xl leading-tight mb-4"
                    >
                        Effortless Operation. Expansive Views.
                    </h2>
                    <p
                        class="text-sm text-text-secondary leading-relaxed mb-6"
                    >
                        Aluminium sliding doors give you large glass panels
                        that glide on precision-engineered tracks; perfect for
                        decks, patios, balconies, and replacement openings
                        where every millimetre of floor space matters. Our
                        Sydney-based installers measure, fabricate, and fit
                        each system so the frame, tracks, rollers, seals, and
                        locking hardware are aligned on site. For wider
                        openings, stacker door systems use multiple parallel
                        rails so up to six panels slide and stack behind one
                        another in a single plane, opening up the room without
                        the folding mechanism of a bi-fold. Both systems are
                        custom fabricated to your opening, with panels up to
                        1500 mm wide and 2700 mm high.
                    </p>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
                        {
                            [
                                "Sliding door installation & replacement",
                                "Up to six panel stacker systems",
                                "Sydney sliding door suppliers",
                                "Whisper-quiet smooth operation",
                                "Slim sightlines, maximum glass",
                                "Multi-point locking hardware",
                                "Flush threshold option (stacker)",
                            ].map(item => (
                                <li class="flex items-start gap-2.5 text-sm text-text-secondary">
                                    <svg
                                        class="size-4 stroke-accent stroke-2 fill-none shrink-0 mt-0.5"
                                        viewBox="0 0 24 24"
                                    >
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    {item}
                                </li>
                            ))
                        }
                    </ul>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href={company.phoneHref}
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase bg-accent text-white hover:bg-accent-hover transition-colors inline-flex items-center gap-2"
                        >
                            Call {company.phoneDisplay}
                        </a>
                        <a
                            href="#quote"
                            class="px-8 py-3.5 text-sm font-semibold tracking-wide uppercase text-accent border border-divider hover:border-accent hover:bg-accent-light transition-all"
                        >
                            Request a Quote
                        </a>
                    </div>
                </div>
                <div
                    class="aspect-6/5 overflow-hidden border-t-[3px] border-t-anodise"
                >
                    <Image
                        src={productImages.slidingDoors.card}
                        alt="Aluminium sliding doors with slim frames in a Sydney home"
                        widths={featureImageWidths}
                        sizes="(min-width: 768px) calc((min(100vw, 80rem) - 7.5rem) / 2), calc(100vw - 3rem)"
                        quality={featureImageQuality}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Partner logos -->
    <PartnerLogosMarquee />

    <!-- Specs -->
    <section class="py-20 bg-alt">
        <div class="max-w-7xl mx-auto px-6">
            <div class="max-w-2xl mb-10">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Specifications
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-3"
                >
                    Built To Order, To Australian Standards
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                    Every sliding and stacker door is custom fabricated to
                    suit your opening. Here is the technical envelope our
                    standard systems work within.
                </p>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                <div>
                    <p
                        class="font-display text-xl mb-4 pb-3 border-b border-divider"
                    >
                        Sliding Doors
                    </p>
                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-divider border border-divider"
                    >
                        {
                            slidingProduct.specs.map(spec => (
                                <div class="p-6 bg-white">
                                    <p class="text-xs font-semibold tracking-widest uppercase text-text-muted mb-2">
                                        {spec.label}
                                    </p>
                                    <p class="font-display text-xl">
                                        {spec.value}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
                <div>
                    <p
                        class="font-display text-xl mb-4 pb-3 border-b border-divider"
                    >
                        Stacker Doors
                    </p>
                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-divider border border-divider"
                    >
                        {
                            stackingProduct.specs.map(spec => (
                                <div class="p-6 bg-white">
                                    <p class="text-xs font-semibold tracking-widest uppercase text-text-muted mb-2">
                                        {spec.label}
                                    </p>
                                    <p class="font-display text-xl">
                                        {spec.value}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 bg-white border-y border-divider">
        <div class="max-w-7xl mx-auto px-6">
            <div class="max-w-3xl mb-12">
                <p
                    class="text-xs font-semibold tracking-widest uppercase text-accent mb-3"
                >
                    Common Questions
                </p>
                <h2
                    class="font-display text-3xl md:text-4xl leading-tight mb-4"
                >
                    Aluminium Sliding & Stacker Doors in Sydney
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                    Practical answers to the questions most Sydney homeowners
                    and builders ask before specifying a sliding or stacker
                    door system.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {
                    adFaqs.map(faq => (
                        <article class="p-8 border border-divider bg-page">
                            <h3 class="font-display text-xl mb-3">
                                {faq.question}
                            </h3>
                            <p class="text-sm text-text-secondary leading-relaxed">
                                {faq.answer}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <AdSharedSections
        whyTag="What We Do"
        whyTitle="Why Sydney Chooses Aluverse for Sliding & Stacker Doors"
        whyText="A specialist sliding door contractor handling every step from measurement and design through to professional installation, replacement, and finish."
        whyItems={whyItems}
        aboutTitle="A Decade of Precision Sliding & Stacker Door Craftsmanship"
        aboutText="Aluverse fabricates and installs custom aluminium sliding and stacker doors across Sydney; from single-home upgrades through to multi-unit residential, hospitality, and commercial projects."
        aboutBullets={aboutBullets}
        quoteTag="Get Started"
        quoteTitle="Ready For Your New Sliding or Stacker Doors?"
        quoteText="Tell us about your project; opening size, panel preference, finishes, timing. We'll respond with a tailored quote within 24 hours."
    />
</AdLayout>
