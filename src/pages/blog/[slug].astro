---
import { getCollection, render } from "astro:content";
import CtaSection from "../../components/CtaSection.astro";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { pageImages, productImages } from "../../assets/images";
import { company } from "../../data/site";
import {
    getArticleSchema,
    getBreadcrumbSchema,
    createAbsoluteUrl,
    createAbsoluteImageUrl,
} from "../../lib/seo";
import type { ImageMetadata } from "astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map(post => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const blogHeroImages: Record<string, ImageMetadata> = {
    "sliding-doors": productImages.slidingDoors.hero,
    "bifold-doors": productImages.bifoldDoors.hero,
    "double-glazing": productImages.doubleGlazingWindows.hero,
    "windows": pageImages.windowsPageHero,
    "casement-windows": productImages.casementWindows.hero,
    "awning-windows": productImages.awningWindows.hero,
    "sliding-windows": productImages.slidingWindows.hero,
    "doors": pageImages.doorsPageHero,
    "workshop": pageImages.workshopPhoto,
};

const heroImage =
    blogHeroImages[post.data.heroImageKey] ?? pageImages.windowsPageHero;

const canonicalUrl = createAbsoluteUrl(`/blog/${post.id}`);
const imageUrl = createAbsoluteImageUrl(heroImage);

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-AU", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });

const postSchema = [
    getBreadcrumbSchema(
        [
            { label: "Home", href: "/" },
            { label: "Blog", href: "/blog" },
            { label: post.data.title, href: `/blog/${post.id}` },
        ],
        `/blog/${post.id}`
    ),
    getArticleSchema({
        title: post.data.title,
        description: post.data.description,
        canonicalUrl,
        publishDate: post.data.publishDate.toISOString(),
        imageUrl,
    }),
];
---

<Layout
    title={`${post.data.title} | Aluverse Blog`}
    description={post.data.description}
    activeNav="blog"
    canonical={`/blog/${post.id}`}
    ogImage={heroImage}
    schema={postSchema}
>
    <PageHero
        title={post.data.title}
        subtitle={formatDate(post.data.publishDate)}
        image={heroImage}
        imageAlt={post.data.heroImageAlt}
        priority={true}
        breadcrumbs={[
            { label: "Home", href: "/" },
            { label: "Blog", href: "/blog" },
            { label: post.data.title },
        ]}
    />

    <article class="py-20 bg-page">
        <div class="max-w-3xl mx-auto px-6">
            <div class="prose">
                <Content />
            </div>
        </div>
    </article>

    <CtaSection
        tag="Ready to start?"
        title="Get a Free Quote for Your Project"
        text="Tell us about your aluminium window or door requirements and we'll prepare a detailed, no-obligation quote."
        primaryHref="/quote"
        primaryLabel="Request a Quote"
        secondaryHref={company.phoneHref}
        secondaryLabel="Call Now"
    />
</Layout>
