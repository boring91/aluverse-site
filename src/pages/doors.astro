---
import CtaSection from '../components/CtaSection.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import { company, doorProducts } from '../data/site';
---

<Layout
	title="Aluminium Doors - Aluverse | Sydney"
	description="Premium aluminium doors for Sydney homes. Sliding, bi-fold, French, hinged and stacking doors custom fabricated for your project."
	activeNav="doors"
>
	<PageHero
		title="Aluminium Doors"
		subtitle="Secure, elegant door systems engineered for Australian conditions. Custom-built to transform your living spaces."
		subtitleClass="hero-subtitle"
		image="https://images.unsplash.com/photo-1600573472592-401b489a3cdc?w=1920&q=80"
		imageAlt="Premium aluminium doors"
		breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Doors' }]}
	/>

	<section class="section">
		<div class="container-wide">
			<div class="section-header section-header-center">
				<div class="section-tag reveal">Our Range</div>
				<h2 class="section-title reveal reveal-delay-1">Door Systems</h2>
				<p class="section-subtitle reveal reveal-delay-2">
					From expansive bi-fold openings to classic French doors, every system is
					precision-engineered.
				</p>
			</div>
			<div class="product-grid">
				{
					doorProducts.map((product, index) => (
						<ProductCard
							product={product}
							revealClass={index === 0 ? 'reveal' : `reveal reveal-delay-${Math.min(index, 3)}`}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section-dark">
		<div class="container-wide">
			<div class="section-header section-header-center">
				<div class="section-tag reveal">Why Aluminium</div>
				<h2 class="section-title reveal reveal-delay-1">The Premium Choice for Sydney Homes</h2>
			</div>
			<div class="services-grid">
				<div class="service-card reveal">
					<div class="service-icon">
						<svg viewBox="0 0 24 24">
							<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
							<path d="M7 11V7a5 5 0 0110 0v4"></path>
						</svg>
					</div>
					<h3>Security</h3>
					<p>
						Heavy-duty aluminium frames with multi-point locking systems provide superior home
						security.
					</p>
				</div>
				<div class="service-card reveal reveal-delay-1">
					<div class="service-icon">
						<svg viewBox="0 0 24 24">
							<path d="M9.59 4.59A2 2 0 1111 8H2"></path>
							<path d="M12.59 19.41A2 2 0 1014 16H2"></path>
							<path d="M17.73 7.73A2.5 2.5 0 1119.5 12H2"></path>
						</svg>
					</div>
					<h3>Weather Resistance</h3>
					<p>
						Engineered seals and durable frames protect against Sydney's weather while
						maintaining smooth operation.
					</p>
				</div>
				<div class="service-card reveal reveal-delay-2">
					<div class="service-icon">
						<svg viewBox="0 0 24 24">
							<polyline points="15 3 21 3 21 9"></polyline>
							<polyline points="9 21 3 21 3 15"></polyline>
							<line x1="21" y1="3" x2="14" y2="10"></line>
							<line x1="3" y1="21" x2="10" y2="14"></line>
						</svg>
					</div>
					<h3>Indoor-Outdoor Living</h3>
					<p>
						Create seamless transitions between your home and outdoor spaces with expansive
						door openings.
					</p>
				</div>
			</div>
		</div>
	</section>

	<CtaSection
		tag="Get Started"
		title="Ready to Transform Your Space?"
		text="Get your free consultation and quote today. Let us craft the perfect aluminium solution for your home or business."
		primaryHref={company.phoneHref}
		primaryLabel={`Call ${company.phoneDisplay}`}
		secondaryHref="/quote"
		secondaryLabel="Request a Quote"
	/>
</Layout>
