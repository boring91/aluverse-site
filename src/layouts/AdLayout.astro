---
import type { ImageMetadata } from "astro";

import { siteUrl } from "../../site-config.mjs";
import { productImages } from "../assets/images";
import TrackingHead from "../components/TrackingHead.astro";
import TrackingNoScript from "../components/TrackingNoScript.astro";
import { company } from "../data/site";
import {
    createAbsoluteImageUrl,
    getBaseSchemas,
    type JsonLdObject,
} from "../lib/seo";
import "../styles/global.css";

type Props = {
    title: string;
    description: string;
    canonical?: string;
    ogImage?: ImageMetadata | string;
    robots?: string;
    schema?: JsonLdObject | JsonLdObject[];
};

const {
    title,
    description,
    canonical,
    ogImage,
    robots = "noindex,nofollow",
    schema,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(siteUrl);
const canonicalUrl = new URL(
    canonical ?? Astro.url.pathname,
    siteOrigin
).toString();
const socialImage = createAbsoluteImageUrl(
    ogImage ?? productImages.stackingDoors.hero
);
const schemaNodes = [
    ...getBaseSchemas({
        title,
        description,
        canonicalUrl,
        imageUrl: socialImage,
    }),
    ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-page">
    <head>
        <TrackingHead />

        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, viewport-fit=cover"
        />

        <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
        <link rel="icon" href="/favicon-light.ico" />
        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon-light.svg"
            media="(prefers-color-scheme: light)"
        />
        <link
            rel="icon"
            href="/favicon-light.ico"
            media="(prefers-color-scheme: light)"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon-dark.svg"
            media="(prefers-color-scheme: dark)"
        />
        <link
            rel="icon"
            href="/favicon-dark.ico"
            media="(prefers-color-scheme: dark)"
        />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=DM+Serif+Text:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <meta name="description" content={description} />
        <meta name="robots" content={robots} />
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:site_name" content={company.name} />
        <meta property="og:locale" content="en_AU" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:alt" content={title} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        <meta name="generator" content={Astro.generator} />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(schemaNodes)}
        />
        <title>{title}</title>
    </head>
    <body
        class="font-body text-text-primary bg-page antialiased overflow-x-hidden leading-relaxed"
    >
        <TrackingNoScript />

        <header
            class="fixed top-0 left-0 right-0 z-50 bg-header-bg border-b border-header-border backdrop-blur-xl pt-[env(safe-area-inset-top)]"
        >
            <div
                class="flex items-center justify-between h-16 max-w-7xl mx-auto px-6"
            >
                <div
                    class="font-display text-2xl text-white flex items-center gap-2"
                >
                    <img class="size-9" src="/logo-dark.svg" alt="" />
                    <p>
                        Alu<span class="text-anodise">verse</span>
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <a
                        href="#quote"
                        class="hidden sm:inline-flex px-4 py-2.5 text-xs font-bold text-anodise border border-anodise/25 tracking-wide uppercase hover:border-anodise/50 hover:text-white transition-all duration-200"
                        >Get Free Quote</a
                    >
                    <a
                        href={company.phoneHref}
                        class="group/phone flex items-center gap-2 px-4 py-2.5 text-xs font-bold bg-anodise text-dark tracking-wide uppercase hover:bg-white transition-all duration-200"
                    >
                        <svg
                            class="size-3.5 stroke-dark fill-none stroke-2 group-hover/phone:stroke-dark transition-colors duration-200"
                            viewBox="0 0 24 24"
                            ><path
                                d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"
                            ></path></svg
                        >
                        Call Now
                    </a>
                </div>
            </div>
        </header>
        <main>
            <slot />
        </main>
        <footer class="bg-dark text-white pt-16 px-6">
            <div
                class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10"
            >
                <div class="flex flex-col gap-2">
                    <div
                        class="font-display text-2xl text-white flex items-center gap-2"
                    >
                        <img class="size-9" src="/logo-dark.svg" alt="" />
                        <p>
                            Alu<span class="text-anodise">verse</span>
                        </p>
                    </div>
                    <p class="text-sm text-white/60 leading-relaxed">
                        {company.tagline}
                    </p>
                </div>
                <div>
                    <p class="font-display text-lg mb-4">Get In Touch</p>
                    <ul class="space-y-2 text-sm text-white/50">
                        <li>
                            <a
                                href={company.phoneHref}
                                class="hover:text-white transition-colors"
                                >{company.phoneDisplay}</a
                            >
                        </li>
                        <li>
                            <a
                                href={company.emailHref}
                                class="hover:text-white transition-colors"
                                >{company.emailDisplay}</a
                            >
                        </li>
                        <li>
                            <a
                                href="#quote"
                                class="hover:text-white transition-colors"
                                >Request a Quote</a
                            >
                        </li>
                    </ul>
                </div>
                <div>
                    <p class="font-display text-lg mb-4">Service & Hours</p>
                    <ul class="space-y-2 text-sm text-white/50">
                        <li>{company.shortHours}</li>
                        <li>7 Days a Week</li>
                        <li>{company.serviceArea}</li>
                    </ul>
                </div>
            </div>
            <div
                class="max-w-7xl mx-auto py-8 mt-12 border-t border-white/10 flex flex-col md:flex-row justify-between items-center text-xs text-white/60 gap-2"
            >
                <span
                    >&copy; {year} Aluverse Doors and Windows. All rights reserved.</span
                >
                <span
                    >Australian Standards Compliant | {company.location}</span
                >
            </div>
        </footer>

        <script is:inline>
            (() => {
                const init = () => {
                    const counters =
                        document.querySelectorAll("[data-target]");
                    if (counters.length) {
                        const runCounterAnimation = () => {
                            counters.forEach(counter => {
                                const target = parseInt(
                                    counter.getAttribute("data-target") || "0",
                                    10
                                );
                                const suffix =
                                    target === 100
                                        ? "%"
                                        : target !== 7
                                          ? "+"
                                          : "";
                                const start = performance.now();
                                const update = now => {
                                    const p = Math.min(
                                        (now - start) / 2000,
                                        1
                                    );
                                    const eased = 1 - Math.pow(1 - p, 3);
                                    counter.textContent =
                                        Math.floor(eased * target) + suffix;
                                    if (p < 1) requestAnimationFrame(update);
                                };
                                requestAnimationFrame(update);
                            });
                        };

                        const observer = new IntersectionObserver(
                            entries => {
                                const isVisible = entries.some(
                                    entry => entry.isIntersecting
                                );
                                if (!isVisible) return;
                                runCounterAnimation();
                                observer.disconnect();
                            },
                            {
                                threshold: 0.2,
                                rootMargin: "0px 0px -10% 0px",
                            }
                        );

                        observer.observe(counters[0]);
                    }

                    document
                        .querySelectorAll("[data-static-form]")
                        .forEach(form => {
                            form.addEventListener("submit", e =>
                                e.preventDefault()
                            );
                        });
                };

                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", init, {
                        once: true,
                    });
                } else {
                    init();
                }
            })();
        </script>
    </body>
</html>
