---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

type Props = {
    title: string;
    description: string;
    activeNav?: "home" | "windows" | "doors" | "about" | "contact";
    canonical?: string;
};

const { title, description, activeNav, canonical } = Astro.props;
const canonicalUrl = canonical ?? Astro.url.href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <!-- Fallback first -->
        <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
        <link rel="icon" href="/favicon-light.ico" />

        <!-- Media-specific variants override the fallback -->
        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon-light.svg"
            media="(prefers-color-scheme: light)"
        />
        <link
            rel="icon"
            href="/favicon-light.ico"
            media="(prefers-color-scheme: light)"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon-dark.svg"
            media="(prefers-color-scheme: dark)"
        />
        <link
            rel="icon"
            href="/favicon-dark.ico"
            media="(prefers-color-scheme: dark)"
        />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=DM+Serif+Text:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body
        class="font-body text-text-primary bg-page antialiased overflow-x-hidden leading-relaxed"
    >
        <div class="hidden lg:block">
            <Header activeNav={activeNav} />
            <main>
                <slot />
            </main>
            <Footer />
        </div>

        <div class="w-full h-screen flex lg:hidden justify-center items-center">
            <p class="font-bold text-4xl p-4 text-center">
                I told you to open it from a computer!
            </p>
        </div>
        <script src="/scripts/site.js" defer></script>
    </body>
</html>
